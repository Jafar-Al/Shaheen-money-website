# dependencies
node_modules/

# build output
dist/
.vercel/
.astro/

# tests
test-results/
playwright-report/
.lighthouseci/

# env
.env
.env.*
!.env.example

# os / editors
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json

# Motion: intermediate frames are regenerated by `npm run motion`.
motion/.frames/
motion/.audio/

# Screenshot sets are reproducible with scripts/shots.mjs; the written
# review (design-review/*.md) is tracked.
design-review/**/*.jpg
design-review/**/*.png

# Local scratch scripts (one-off captures, debugging).
*.tmp.mjs
*.tmp.mts

# The presentations stay on the owner's machine (shared as PDF, not in the repo).
presentation/
