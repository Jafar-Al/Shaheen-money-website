{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs",
      "startServerReadyPattern": "Preview:",
      "url": [
        "http://localhost:4321/en",
        "http://localhost:4321/ar",
        "http://localhost:4321/en/connectors",
        "http://localhost:4321/ar/pricing"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "screenEmulation": { "mobile": true, "width": 390, "height": 844, "deviceScaleFactor": 3, "disabled": false }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": ["error", { "maxNumericValue": 1800 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 1200 }],
        "resource-summary:total:size": ["error", { "maxNumericValue": 512000 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 153600 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 122880 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 40960 }],
        "resource-summary:font:size": ["error", { "maxNumericValue": 122880 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 0 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
