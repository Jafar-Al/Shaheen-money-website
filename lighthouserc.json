{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve.mjs",
      "startServerReadyPattern": "Preview:",
      "url": [
        "http://localhost:4321/en",
        "http://localhost:4321/ar",
        "http://localhost:4321/en/business",
        "http://localhost:4321/ar/contact"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "perf",
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "screenEmulation": {
          "mobile": true,
          "width": 390,
          "height": 844,
          "deviceScaleFactor": 3,
          "disabled": false
        },
        "throttling": {
          "rttMs": 170,
          "throughputKbps": 9000,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "assertions": {
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.02
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 1800
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 512000
          }
        ],
        "resource-summary:image:size": [
          "error",
          {
            "maxNumericValue": 153600
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 122880
          }
        ],
        "resource-summary:stylesheet:size": [
          "error",
          {
            "maxNumericValue": 40960
          }
        ],
        "resource-summary:font:size": [
          "error",
          {
            "maxNumericValue": 122880
          }
        ],
        "resource-summary:third-party:count": [
          "error",
          {
            "maxNumericValue": 0
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
