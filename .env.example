# Copy to .env for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Everything is optional in
# development; production needs at least one form delivery sink.

# Preview builds: show dashed "content needed" markers where facts are missing.
PUBLIC_SHOW_CONTENT_GAPS=false

# Form delivery (at least one in production)
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=
RESEND_API_KEY=
FORMS_EMAIL_TO=
FORMS_EMAIL_FROM=

# Shared rate limiting across serverless instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile on the two forms
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cookieless analytics, e.g. Plausible (ideally proxied first-party)
PUBLIC_ANALYTICS_SCRIPT_SRC=
PUBLIC_ANALYTICS_DOMAIN=

# Operations console (src/server/admin, ADMIN_AUTH_INTEGRATION.md).
# Staff accounts and the session key: run `npm run admin:add -- --email …
# --name … --role ADMIN`, which writes both here and prints them for Vercel.
# Without them, development accepts the test accounts in
# src/admin/mock/admins.ts; production refuses every sign-in.
ADMIN_ACCOUNTS=
ADMIN_SESSION_SECRET=
# shaheen (the app's database, src/server/admin/shaheen-source.ts; the
# production default) or demo (generated data, stamped; the development default)
# ADMIN_DATA_SOURCE=demo
# Production requires a second factor; 'false' allows accounts without one.
# ADMIN_REQUIRE_MFA=true
# 'true' makes a deployment a showcase (generated data and the demo accounts)
# until src/server/admin/shaheen-source.ts is connected; then it is ignored.
# ADMIN_DEMO=true
