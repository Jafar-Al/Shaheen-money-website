# Copy to .env for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Everything is optional in
# development; production needs at least one form delivery sink.

# Preview builds: show dashed "content needed" markers where facts are missing.
PUBLIC_SHOW_CONTENT_GAPS=false

# Form delivery (at least one in production)
FORMS_WEBHOOK_URL=
FORMS_WEBHOOK_SECRET=
RESEND_API_KEY=
FORMS_EMAIL_TO=
FORMS_EMAIL_FROM=

# Shared rate limiting across serverless instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile on the two forms
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cookieless analytics, e.g. Plausible (ideally proxied first-party)
PUBLIC_ANALYTICS_SCRIPT_SRC=
PUBLIC_ANALYTICS_DOMAIN=
