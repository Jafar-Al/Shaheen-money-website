---
import QRCode from 'qrcode';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import StoreBadges from '../../components/site/StoreBadges.astro';
import Device from '../../components/app/Device.astro';
import FalconFold from '../../components/home/FalconFold.astro';
import Slip from '../../components/ui/Slip.astro';
import Stamp from '../../components/ui/Stamp.astro';
import Emph from '../../components/ui/Emph.astro';
import { getApp } from '../../copy/misc';
import { common } from '../../copy/common';
import { DOWNLOAD_URL } from '../../config/download';
import { localeStaticPaths, type Locale } from '../../i18n/config';

/**
 * Where /download sends computers (and anything that is not a phone): the
 * closing scene of the homepage as a page of its own. Both stores, the app
 * as it is, and the QR code for the phone on a paper slip, with the
 * official-links warning stamped on it.
 */
export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.locale as Locale;
const t = getApp[locale];

const qr = (
  await QRCode.toString(DOWNLOAD_URL, {
    type: 'svg',
    errorCorrectionLevel: 'H',
    margin: 0,
    color: { dark: '#071138ff', light: '#ffffff00' },
  })
).replace('<svg ', '<svg aria-hidden="true" focusable="false" width="100%" height="100%" ');
---

<BaseLayout locale={locale} path="/get-the-app" title={t.meta.title} description={t.meta.description} temp="night">
  <section class="app-hero under-header t-night grain" data-temp="night" data-app-hero>
    <div class="page app-hero-inner">
      <Breadcrumbs locale={locale} items={[{ label: common[locale].nav.getApp }]} />
      <div class="app-grid">
        <div class="app-copy">
          <FalconFold />
          <h1 class="text-display-l font-display"><Emph text={t.title} /></h1>
          <p class="lead">{t.lead}</p>
          <StoreBadges locale={locale} />
        </div>
        <Device locale={locale} class="app-device" />
      </div>
    </div>
  </section>

  <section class="t-paper app-scan" data-temp="paper">
    <div class="page rhythm app-scan-inner">
      <Slip no="shaheen.money/download" class="app-slip">
        <div class="app-qr">
          <div class="app-qr-code" set:html={qr} />
          <span class="app-qr-mark" aria-hidden="true">
            <svg viewBox="0 0 240 240" width="26" height="26" focusable="false"><use href="#falcon-mark"></use></svg>
          </span>
        </div>
        <p class="app-scan-text">{t.scan}</p>
      </Slip>
      <p class="app-official">
        <Stamp locale={locale} kind="note" tilt={-2} />
        <span>{t.official}</span>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .app-hero,
  .app-scan {
    background-color: var(--bg);
    color: var(--fg);
  }
  .app-hero {
    overflow: clip;
  }
  .app-hero-inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-block: calc(var(--header-h) + 1.5rem) var(--section);
  }
  .app-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 4rem;
    align-items: center;
  }
  .app-copy {
    grid-column: 1 / span 6;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }
  .app-grid :global(.app-device) {
    grid-column: 8 / -1;
  }
  .app-scan-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }
  .app-scan-inner :global(.app-slip) {
    inline-size: min(100%, 22rem);
    rotate: -1.5deg;
  }
  .app-qr {
    position: relative;
    aspect-ratio: 1;
    padding: 0.75rem;
    background-color: #fff;
  }
  .app-qr-code {
    inline-size: 100%;
    block-size: 100%;
  }
  .app-qr-mark {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .app-qr-mark svg {
    padding: 0.625rem;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border: 4px solid #fff;
    border-radius: var(--radius-full);
    background-color: var(--color-navy-800);
    color: #fff;
  }
  .app-scan-text {
    margin-block-start: 1.25rem;
    text-align: center;
  }
  .app-official {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    max-inline-size: 36rem;
    text-align: center;
    color: var(--fg-2);
  }
  @media (width < 64rem) {
    .app-copy,
    .app-grid :global(.app-device) {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  import { initParallax } from '../../lib/motion/pointer';
  const hero = document.querySelector<HTMLElement>('[data-app-hero]');
  if (hero) initParallax(hero);
</script>
