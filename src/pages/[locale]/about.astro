---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Ledger from '../../components/ui/Ledger.astro';
import IndexRow from '../../components/ui/IndexRow.astro';
import TextLink from '../../components/ui/TextLink.astro';
import Plate from '../../components/ui/Plate.astro';
import Gap from '../../components/ui/Gap.astro';
import { about } from '../../copy/trust';
import { common } from '../../copy/common';
import { facts } from '../../data/facts';
import { documentsFor } from '../../data/media';
import { showGaps } from '../../lib/gaps';
import { href, localeStaticPaths, type Locale } from '../../i18n/config';

/**
 * About: the story as a timeline (Bankey → Empowch → Shaheen Money, the
 * present step marked), what we are building as numbered statements on
 * Night, what we hold to as a ledger, leadership as a typographic index
 * (photographs only when real and consented, through Plate), and the
 * company's details.
 */
export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.locale as Locale;
const t = about[locale];
const founder = facts.team[0];
const c = facts.company;
const companyLines = [c.legalName, c.registrationNumber, c.registeredAddress?.[locale], c.jurisdiction?.[locale]].filter(
  (x): x is string => Boolean(x),
);
const office = c.office?.value;
const profile = documentsFor(locale).find((d) => d.id === 'company-profile');
const last = t.chapters.length - 1;
---

<BaseLayout locale={locale} path="/about" title={t.meta.title} description={t.meta.description}>
  <PageHero locale={locale} title={t.title} lead={t.lead} crumbs={[{ label: common[locale].nav.about.title }]} seed="about" />

  <section class="t-paper about-story" data-temp="paper" aria-labelledby="story-title">
    <div class="page rhythm">
      <h2 id="story-title" class="about-h2 font-display">{t.storyTitle}</h2>
      <ol class="timeline" data-reveal>
        {
          t.chapters.map((ch, i) => (
            <li class:list={['tl-step', i === last && 'tl-now']} data-reveal-child>
              <span class="tl-mark" aria-hidden="true">
                <span class="tl-n num">{String(i + 1).padStart(2, '0')}</span>
                <span class="tl-line" />
              </span>
              <h3 class="tl-name font-display" lang={/[a-z]/i.test(ch.name) ? 'en' : undefined}>
                {ch.name}
              </h3>
              <p class="tl-body">{ch.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="t-night grain about-mission" data-temp="night" aria-labelledby="mission-title">
    <div class="page rhythm mission-grid">
      <h2 id="mission-title" class="about-h2 font-display">{t.missionTitle}</h2>
      <ol class="mission" data-reveal>
        {
          t.mission.map((paragraph, i) => (
            <li class="mission-item" data-reveal-child>
              <span class="num mission-n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <p class="mission-text font-display">{paragraph}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="t-paper grain" data-temp="paper" aria-labelledby="principles-title">
    <div class="page rhythm split">
      <h2 id="principles-title" class="about-h2 font-display">{t.principlesTitle}</h2>
      <Ledger items={t.principles.map((p) => ({ title: p.title, body: p.body }))} class="split-main" />
    </div>
  </section>

  <section class="t-paper about-people" data-temp="paper" aria-labelledby="leadership-title">
    <div class="page rhythm split">
      <h2 id="leadership-title" class="about-h2 font-display">{t.leadershipTitle}</h2>
      <div class="split-main">
        <div class="people">
          {
            facts.team.map((person, i) => (
              <div class="person">
                <Plate src={person.photo} alt={person.name} width={200} ratio="portrait" class="person-photo" />
                <IndexRow
                  n={i + 1}
                  title={locale === 'ar' && person.nameAr ? person.nameAr : person.name}
                  meta={person.role[locale]}
                  headingLevel="h3"
                />
              </div>
            ))
          }
        </div>
        {
          founder && (
            <figure class="quote">
              <blockquote class="quote-text font-display">
                <p>{t.quote}</p>
              </blockquote>
              <figcaption class="label quote-by">
                {locale === 'ar' && founder.nameAr ? founder.nameAr : founder.name} · {founder.role[locale]}
              </figcaption>
            </figure>
          )
        }
        <Gap need="The Arabic spelling of each name. The founder quote is the wording published on the current About page: confirm it is still what he wants to say." />
      </div>
    </div>
  </section>

  {
    (companyLines.length > 0 || office || showGaps) && (
      <section class="t-paper about-company" data-temp="paper" aria-labelledby="company-title">
        <div class="page rhythm-dense split">
          <h2 id="company-title" class="label about-company-title">
            {t.companyTitle}
          </h2>
          <div class="split-main about-company-body">
            {companyLines.length > 0 && <p>{companyLines.join(' · ')}</p>}
            {office && (
              <p>
                <bdi dir="ltr">{office.address}</bdi> ·{' '}
                <a href={`tel:${office.phone.replace(/[^+\d]/g, '')}`} class="ink-link num" dir="ltr">
                  {office.phone}
                </a>
              </p>
            )}
            {profile?.download && (
              <TextLink href={profile.download.file} download>
                {t.profileCta}
              </TextLink>
            )}
            {companyLines.length === 0 && <Gap need="The company name (src/data/facts.ts)." />}
          </div>
        </div>
      </section>
    )
  }

  <section class="t-paper" data-temp="paper">
    <div class="page about-links">
      <TextLink href={href(locale, 'blog')} size="lg">{t.blogCta}</TextLink>
      <TextLink href={href(locale, 'business')} size="lg">{t.businessCta}</TextLink>
      <TextLink href={href(locale, 'contact')} size="lg">{t.contactCta}</TextLink>
    </div>
  </section>
</BaseLayout>

<style>
  section {
    background-color: var(--bg);
    color: var(--fg);
  }
  .about-h2 {
    font-size: var(--text-display-m);
    line-height: var(--lh-display-m);
    max-inline-size: 14ch;
  }

  .timeline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem var(--gutter);
    margin-block-start: clamp(3rem, 6vw, 5rem);
  }
  .tl-step {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .tl-mark {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .tl-n {
    font-size: var(--text-label);
    color: var(--fg-2);
  }
  .tl-line {
    flex: 1;
    block-size: 1px;
    background-color: var(--line-strong);
  }
  .tl-now .tl-n {
    color: var(--accent);
  }
  .tl-now .tl-line {
    block-size: 2px;
    background-color: var(--fg);
  }
  .tl-name {
    font-size: var(--text-h3);
    line-height: var(--lh-h3);
  }
  .tl-now .tl-name {
    font-size: var(--text-display-m);
    line-height: var(--lh-display-m);
  }
  .tl-body {
    max-inline-size: 36ch;
    color: var(--fg-2);
  }

  .mission-grid,
  .split {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2.5rem;
    align-items: start;
  }
  .mission-grid > h2,
  .split > h2 {
    grid-column: 1 / span 4;
  }
  .mission,
  .split-main,
  .split :global(.split-main) {
    grid-column: 6 / -1;
  }
  .mission {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .mission-item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
  }
  .mission-n {
    font-size: var(--text-label);
    color: var(--accent);
    padding-block-start: 0.5rem;
  }
  .mission-text {
    font-size: var(--text-h3);
    line-height: 1.22;
  }
  :global(:lang(ar)) .mission-text {
    line-height: 1.6;
  }

  .people {
    display: flex;
    flex-direction: column;
    border-block-start: 1px solid var(--line);
  }
  .person {
    display: flex;
    align-items: flex-end;
    gap: 1.5rem;
  }
  .person :global(.person-photo) {
    inline-size: 9rem;
    flex: none;
  }
  .person :global(.index-row) {
    flex: 1;
  }
  .quote {
    margin: 3rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .quote-text {
    font-size: var(--text-h3);
    line-height: 1.25;
  }
  .quote-text p::before {
    content: '“';
  }
  .quote-text p::after {
    content: '”';
  }
  :global(:lang(ar)) .quote-text {
    line-height: 1.7;
  }
  :global(:lang(ar)) .quote-text p::before {
    content: '«';
  }
  :global(:lang(ar)) .quote-text p::after {
    content: '»';
  }
  .quote-by {
    color: var(--fg-2);
  }

  .about-company {
    border-block-start: 1px solid var(--line);
  }
  .about-company-title {
    color: var(--fg-2);
  }
  .about-company-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--fg-2);
  }
  .about-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 3rem;
    padding-block: 2rem var(--section);
  }

  @media (width < 64rem) {
    .timeline {
      grid-template-columns: minmax(0, 1fr);
    }
    .mission-grid > h2,
    .split > h2,
    .mission,
    .split-main,
    .split :global(.split-main) {
      grid-column: 1 / -1;
    }
  }
</style>
