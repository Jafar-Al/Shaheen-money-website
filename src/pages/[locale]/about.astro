---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/ui/PageHeader.astro';
import Section from '../../components/ui/Section.astro';
import TextLink from '../../components/ui/TextLink.astro';
import Photo from '../../components/media/Photo.astro';
import Gap from '../../components/ui/Gap.astro';
import { about } from '../../copy/trust';
import { common } from '../../copy/common';
import { facts } from '../../data/facts';
import { showGaps } from '../../lib/gaps';
import { href, localeStaticPaths, type Locale } from '../../i18n/config';

export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.locale as Locale;
const t = about[locale];
const founder = facts.team[0];
const c = facts.company;
const companyLines = [c.legalName, c.registrationNumber, c.registeredAddress?.[locale], c.jurisdiction?.[locale]].filter(
  (x): x is string => Boolean(x),
);
---

<BaseLayout locale={locale} path="/about" title={t.meta.title} description={t.meta.description}>
  <PageHeader locale={locale} title={t.title} lead={t.lead} crumbs={[{ label: common[locale].nav.about.title }]} />

  <Section labelledby="story-title">
    <h2 id="story-title" class="text-h2 font-display">{t.storyTitle}</h2>
    <ol class="mt-10 grid gap-x-8 gap-y-10 md:grid-cols-3">
      {
        t.chapters.map((ch, i) => (
          <li class:list={['flex flex-col gap-3 border-t-2 pt-6', i === t.chapters.length - 1 ? 'border-navy' : 'border-line']}>
            <h3 class="text-h3 font-display" lang={/[a-z]/i.test(ch.name) ? 'en' : undefined}>
              {ch.name}
            </h3>
            <p class="text-body text-fg-2">{ch.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section tone="navy" labelledby="mission-title">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
      <h2 id="mission-title" class="text-h1 font-display lg:col-span-5">{t.missionTitle}</h2>
      <div class="flex flex-col gap-5 lg:col-span-7">
        {t.mission.map((paragraph) => <p class="measure text-body-lg text-fg-inverse-2">{paragraph}</p>)}
      </div>
    </div>
  </Section>

  <Section tone="subtle" labelledby="principles-title">
    <h2 id="principles-title" class="text-h2 font-display">{t.principlesTitle}</h2>
    <dl class="mt-10 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.principles.map((p) => (
          <div class="flex flex-col gap-2">
            <dt class="text-body-lg font-semibold">{p.title}</dt>
            <dd class="text-body text-fg-2">{p.body}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <Section labelledby="leadership-title">
    <h2 id="leadership-title" class="text-h2 font-display">{t.leadershipTitle}</h2>
    <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {
        facts.team.map((person) => (
          <li class="flex items-center gap-4 border-t-2 border-line pt-6">
            {person.photo && (
              <Photo src={person.photo} alt={person.name} width={80} sizes="80px" class="size-20 rounded-full object-cover" />
            )}
            <span class="flex flex-col">
              <span class="text-body-lg font-semibold">{locale === 'ar' && person.nameAr ? person.nameAr : person.name}</span>
              <span class="text-body-sm text-fg-2">{person.role[locale]}</span>
            </span>
          </li>
        ))
      }
    </ul>

    {
      founder && (
        <figure class="mt-14 flex flex-col gap-5 border-s-2 border-navy ps-6 md:ps-10">
          <blockquote class="measure text-h2 font-display text-fg">
            <p>{t.quote}</p>
          </blockquote>
          <figcaption class="text-body text-fg-2">
            {locale === 'ar' && founder.nameAr ? founder.nameAr : founder.name} · {founder.role[locale]}
          </figcaption>
        </figure>
      )
    }

    <Gap class="mt-8" need="Leadership photos (consented) and the Arabic spelling of each name. The founder quote on this page is the wording published on the current About page: confirm it is still what he wants to say." />
  </Section>

  {
    (companyLines.length > 0 || showGaps) && (
      <Section tone="subtle" labelledby="company-title" spacing="sm">
        <h2 id="company-title" class="text-h3 font-display">{t.companyTitle}</h2>
        {companyLines.length > 0 ? (
          <p class="mt-4 text-body text-fg-2">{companyLines.join(' · ')}</p>
        ) : (
          <Gap class="mt-4" need="Registered entity name, company number, registered address and jurisdiction." />
        )}
      </Section>
    )
  }

  <Section spacing="sm">
    <div class="flex flex-wrap gap-x-8">
      <TextLink href={href(locale, 'blog')}>{t.blogCta}</TextLink>
      <TextLink href={href(locale, 'business')}>{t.businessCta}</TextLink>
      <TextLink href={href(locale, 'contact')}>{t.contactCta}</TextLink>
    </div>
  </Section>
</BaseLayout>
