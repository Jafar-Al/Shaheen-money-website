---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/ui/Section.astro';
import TextLink from '../../../components/ui/TextLink.astro';
import { contactPage } from '../../../copy/support';
import { href, localeStaticPaths, type Locale } from '../../../i18n/config';

/** Where the contact form lands without JavaScript. Never indexed. */
export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.locale as Locale;
const t = contactPage[locale].success;
---

<BaseLayout locale={locale} path="/contact/sent" title={`${t.title} — Shaheen Money`} description={t.body} noindex>
  <Section spacing="lg" container="narrow">
    <div class="flex flex-col items-start gap-5 rounded-lg bg-success-bg p-10">
      <h1 class="text-display-lg font-display">{t.title}</h1>
      <p class="text-body-lg">{t.body}</p>
      <TextLink href={href(locale, 'home')}>{t.next}</TextLink>
    </div>
  </Section>
</BaseLayout>
