---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import TextLink from '../../../components/ui/TextLink.astro';
import Slip from '../../../components/ui/Slip.astro';
import FormShell from '../../../components/forms/FormShell.astro';
import TextField from '../../../components/forms/TextField.astro';
import SelectField from '../../../components/forms/SelectField.astro';
import ConsentField from '../../../components/forms/ConsentField.astro';
import { apply, formMessages } from '../../../copy/support';
import { business } from '../../../copy/business';
import { common } from '../../../copy/common';
import { SHOP_TYPES, COMPANY_TYPES } from '../../../lib/forms/schema';
import { plain } from '../../../lib/emph';
import { href, localeStaticPaths, type Locale } from '../../../i18n/config';

/**
 * One application for a shop and for a company. The two option groups are
 * built from the same arrays the server validates against, so a choice can
 * never be offered that the endpoint would reject.
 */
export const getStaticPaths = localeStaticPaths;
const locale = Astro.params.locale as Locale;
const t = apply[locale];
const m = formMessages[locale];
const b = business[locale];

const pick = <K extends readonly string[]>(keys: K) => Object.fromEntries(keys.map((k) => [k, t.types[k as keyof typeof t.types]]));

const typeGroups = [
  { label: t.typeGroups.shop, options: pick(SHOP_TYPES) },
  { label: t.typeGroups.company, options: pick(COMPANY_TYPES) },
];
---

<BaseLayout locale={locale} path="/business/apply" title={t.meta.title} description={t.meta.description}>
  <PageHero
    locale={locale}
    title={t.title}
    lead={t.lead}
    crumbs={[{ label: common[locale].nav.business.title, href: href(locale, 'business') }, { label: plain(t.title) }]}
    seed="business-apply"
    size="m"
  />

  <section class="t-paper grain apply" data-temp="paper">
    <div class="page rhythm apply-grid">
      <div class="apply-form">
        <FormShell action="/api/forms/business" locale={locale} submitLabel={t.submit} successId="apply-success">
          <SelectField
            name="type"
            label={t.type}
            hint={t.typeHint}
            placeholder={t.typeChoose}
            groups={typeGroups}
            options={{ other: t.types.other }}
            required
          />
          <TextField name="name" label={t.name} autocomplete="name" required maxlength={120} />
          <TextField name="business" label={t.business} autocomplete="organization" required maxlength={160} />
          <div class="apply-pair">
            <TextField name="country" label={t.country} autocomplete="country-name" required maxlength={80} />
            <TextField name="city" label={t.city} autocomplete="address-level2" required maxlength={80} />
          </div>
          <TextField name="phone" label={t.phone} hint={t.phoneHint} type="tel" inputmode="tel" autocomplete="tel" dir="ltr" required maxlength={20} />
          <TextField name="email" label={t.email} optionalLabel={m.optional} type="email" autocomplete="email" dir="ltr" maxlength={254} />
          <TextField name="message" label={t.message} hint={t.messageHint} optionalLabel={m.optional} multiline maxlength={1000} />
          <ConsentField before={t.consentBefore} linkLabel={m.privacyLink} href={href(locale, 'privacy')} />
        </FormShell>

        <div id="apply-success" hidden role="status">
          <Slip no={t.success.title}>
            <h2 tabindex="-1" class="apply-success-title font-display">{t.success.title}</h2>
            <p class="apply-success-body">{t.success.body}</p>
            <TextLink href={href(locale, 'business')}>{t.success.next}</TextLink>
          </Slip>
        </div>
      </div>

      <aside class="apply-aside">
        <Slip no={common[locale].ui.note}>
          <p class="apply-note">{t.privacyNote}</p>
        </Slip>
        <div class="apply-steps">
          <h2 class="apply-steps-title font-display">{b.connectors.stepsTitle}</h2>
          <ol>
            {
              b.connectors.steps.map((step, i) => (
                <li>
                  <span class="num" aria-hidden="true">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="apply-step">
                    <span class="apply-step-title">{step.title}</span>
                    <span class="apply-step-body">{step.body}</span>
                  </span>
                </li>
              ))
            }
          </ol>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .apply {
    background-color: var(--bg);
    color: var(--fg);
  }
  .apply-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 4rem;
    align-items: start;
  }
  .apply-form {
    grid-column: 1 / span 7;
  }
  .apply-pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
  }
  .apply-aside {
    grid-column: 9 / -1;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  @media (width >= 64rem) {
    .apply-aside {
      position: sticky;
      inset-block-start: calc(var(--header-h) + 2rem);
    }
  }
  .apply-note {
    font-size: var(--text-body-s);
  }
  .apply-steps-title {
    font-size: var(--text-h4);
    margin-block-end: 1rem;
  }
  .apply-steps li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 0.5rem;
    padding-block: 1rem;
    border-block-start: 1px solid var(--line);
  }
  .apply-steps .num {
    font-size: var(--text-label);
    color: var(--accent);
    padding-block-start: 0.2rem;
  }
  .apply-step {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .apply-step-title {
    font-weight: 600;
  }
  .apply-step-body {
    font-size: var(--text-body-s);
    color: var(--fg-2);
  }
  .apply-success-title {
    font-size: var(--text-h3);
    outline: none;
  }
  .apply-success-body {
    margin-block: 0.75rem 1rem;
  }
  @media (width < 64rem) {
    .apply-form,
    .apply-aside {
      grid-column: 1 / -1;
    }
  }
  @media (width < 30rem) {
    .apply-pair {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
