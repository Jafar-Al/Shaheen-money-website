---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/ui/PageHeader.astro';
import Section from '../../../components/ui/Section.astro';
import Notice from '../../../components/ui/Notice.astro';
import Gap from '../../../components/ui/Gap.astro';
import { common } from '../../../copy/common';
import { legalPage } from '../../../copy/misc';
import { contact } from '../../../config/site';
import { formatDate } from '../../../lib/format';
import { locales, type Locale } from '../../../i18n/config';

type Doc = 'privacy' | 'terms' | 'cookies';

// getStaticPaths runs in its own scope: it can only use imports.
export function getStaticPaths() {
  return locales.flatMap((locale) => (['privacy', 'terms', 'cookies'] as const).map((doc) => ({ params: { locale, doc } })));
}

const locale = Astro.params.locale as Locale;
const doc = Astro.params.doc as Doc;
const f = common[locale].footer;
const ui = common[locale].ui;
const t = legalPage[locale];
const titles: Record<Doc, string> = { privacy: f.privacy, terms: f.terms, cookies: f.cookies };

const entry = await getEntry('legal', `${locale}/${doc}`);
const rendered = entry ? await render(entry) : null;
const title = entry?.data.title ?? titles[doc];
---

<BaseLayout
  locale={locale}
  path={`/legal/${doc}`}
  title={`${title} — Shaheen Money`}
  description={t.descriptions[doc]}
  noindex={!entry || entry.data.status === 'draft'}
>
  <PageHeader locale={locale} title={title} crumbs={[{ label: f.legal }, { label: title }]}>
    {
      entry && (
        <p class="text-caption text-fg-2">
          {t.version} <span class="num">{entry.data.version}</span> · {t.effective}{' '}
          <time datetime={entry.data.effectiveFrom.toISOString().slice(0, 10)}>{formatDate(entry.data.effectiveFrom, locale)}</time>
        </p>
      )
    }
  </PageHeader>
  <Section container="narrow">
    {
      entry && entry.data.status === 'draft' && (
        <Notice kind="warning" class="mb-10">
          <p>{ui.draftBanner}</p>
        </Notice>
      )
    }
    {
      rendered ? (
        <div class="prose measure">
          <rendered.Content />
        </div>
      ) : (
        <div class="flex max-w-2xl flex-col gap-6">
          <Notice kind="info">
            <p>
              {t.pending} <a href={`mailto:${contact.email}`} class="underline" dir="ltr">{contact.email}</a>
            </p>
          </Notice>
          <Gap
            need={`${titles[doc]} (${locale}). Migrate the current document with \`npm run import:legacy\`, then have legal review it and set status: approved.`}
            where={`src/content/legal/${locale}/${doc}.md`}
          />
        </div>
      )
    }
  </Section>
</BaseLayout>
