---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import DownloadButton from '../../../components/site/DownloadButton.astro';
import TextLink from '../../../components/ui/TextLink.astro';
import IndexRow from '../../../components/ui/IndexRow.astro';
import Photo from '../../../components/media/Photo.astro';
import FeatherField from '../../../components/art/FeatherField.astro';
import { blog } from '../../../copy/blog';
import { common } from '../../../copy/common';
import { categoryLabel, getPosts, postLocale, postSlug, type Post } from '../../../lib/blog';
import { formatDate, readingMinutes } from '../../../lib/format';
import { absoluteUrl, href, locales, otherLocale, type Locale } from '../../../i18n/config';
import { SITE_URL } from '../../../config/site';

export async function getStaticPaths() {
  const all = (await Promise.all(locales.map((l) => getPosts(l)))).flat();
  return all.map((post) => ({
    params: { locale: postLocale(post), slug: postSlug(post) },
    props: {
      post,
      hasTwin: all.some((p) => postLocale(p) !== postLocale(post) && postSlug(p) === postSlug(post)),
    },
  }));
}

interface Props {
  post: Post;
  hasTwin: boolean;
}

/**
 * A post, for reading: its own engraved feather across the top, the title
 * in the display face, a measure of 68 characters (60 in Arabic), a drop
 * cap in Latin, and a hairline across the very top that fills as you read.
 */
const { post, hasTwin } = Astro.props;
const locale = Astro.params.locale as Locale;
const slug = postSlug(post);
const t = blog[locale];
const ui = common[locale].ui;
const { Content } = await render(post);
const minutes = readingMinutes(post.body ?? '', locale);
const path = `/blog/${slug}`;
const related = (await getPosts(locale)).filter((p) => postSlug(p) !== slug && p.data.category === post.data.category).slice(0, 2);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    inLanguage: locale,
    datePublished: post.data.publishedAt.toISOString(),
    dateModified: (post.data.updatedAt ?? post.data.publishedAt).toISOString(),
    author: { '@type': 'Person', name: post.data.author },
    publisher: { '@id': `${SITE_URL}/#organization` },
    mainEntityOfPage: absoluteUrl(`/${locale}${path}`),
    image: absoluteUrl(`/og/${locale}${path}.png`),
    articleSection: categoryLabel[post.data.category][locale],
  },
];
---

<BaseLayout
  locale={locale}
  path={path}
  title={`${post.data.title} — Shaheen Money`}
  description={post.data.description}
  ogType="article"
  otherLocalePath={hasTwin ? undefined : href(otherLocale(locale), 'blog')}
  article={{
    publishedTime: post.data.publishedAt.toISOString(),
    modifiedTime: post.data.updatedAt?.toISOString(),
    section: categoryLabel[post.data.category][locale],
  }}
  jsonLd={jsonLd}
>
  <div class="read-progress" aria-hidden="true" data-read-progress><span></span></div>

  <article class="post" data-post>
    <header class="post-head under-header t-paper grain" data-temp="paper">
      <div class="post-art" aria-hidden="true">
        <FeatherField seed={slug} variant="strip" follow />
      </div>
      <div class="page post-head-inner">
        <Breadcrumbs locale={locale} items={[{ label: common[locale].nav.blog.title, href: href(locale, 'blog') }, { label: post.data.title }]} />
        <div class="post-title-block">
          <p class="label post-kicker">{categoryLabel[post.data.category][locale]}</p>
          <h1 class="text-display-l font-display post-title">{post.data.title}</h1>
          <p class="lead">{post.data.description}</p>
          <p class="micro post-meta">
            {t.by} {post.data.author}
            <span aria-hidden="true"> · </span>
            <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
            {
              post.data.updatedAt && (
                <>
                  <span aria-hidden="true"> · </span>
                  {ui.updated} <time datetime={post.data.updatedAt.toISOString()}>{formatDate(post.data.updatedAt, locale)}</time>
                </>
              )
            }
            <span aria-hidden="true"> · </span>
            <span class="num">{minutes}</span> {ui.minRead}
          </p>
        </div>
      </div>
    </header>

    <div class="t-paper post-body" data-temp="paper">
      {
        post.data.heroImage && (
          <div class="page post-image">
            <Photo
              src={post.data.heroImage}
              alt={post.data.heroAlt ?? ''}
              width={960}
              sizes="(min-width: 64rem) 960px, 92vw"
              priority
              class="post-photo"
            />
          </div>
        )
      }
      <div class="page rhythm">
        <div class="prose prose-dropcap reading post-prose">
          <Content />
        </div>
      </div>
    </div>
  </article>

  <aside class="t-night grain post-cta" data-temp="night">
    <div class="page rhythm-dense post-cta-inner">
      <h2 class="post-cta-title font-display">{t.cta.title}</h2>
      <p class="lead">{t.cta.body}</p>
      <DownloadButton locale={locale} />
    </div>
  </aside>

  <section class="t-paper post-more" data-temp="paper">
    <div class="page rhythm">
      {
        related.length > 0 && (
          <div class="post-related">
            <h2 class="post-related-title font-display">{t.related}</h2>
            <ol class="post-related-list">
              {related.map((p, i) => (
                <li>
                  <IndexRow
                    n={i + 1}
                    kicker={categoryLabel[p.data.category][locale]}
                    title={p.data.title}
                    meta={formatDate(p.data.publishedAt, locale)}
                    href={`${href(locale, 'blog')}/${postSlug(p)}`}
                  />
                </li>
              ))}
            </ol>
          </div>
        )
      }
      <TextLink href={href(locale, 'blog')} size="lg">{t.backToBlog}</TextLink>
    </div>
  </section>
</BaseLayout>

<style>
  .read-progress {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 60;
    block-size: 2px;
    pointer-events: none;
  }
  .read-progress span {
    display: block;
    block-size: 100%;
    background-color: var(--color-signal-ink);
    transform-origin: left;
    scale: var(--p, 0) 1;
  }
  :global([dir='rtl']) .read-progress span {
    transform-origin: right;
  }
  .post-head,
  .post-body,
  .post-more {
    background-color: var(--bg);
    color: var(--fg);
  }
  .post-head {
    position: relative;
    overflow: clip;
    border-block-end: 1px solid var(--line);
  }
  .post-art {
    position: absolute;
    inset: 0 0 auto;
    block-size: clamp(9rem, 22vw, 17rem);
    color: var(--fg);
  }
  .post-head-inner {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 9vw, 7rem);
    padding-block: calc(var(--header-h) + 1.5rem) clamp(3rem, 6vw, 5rem);
  }
  .post-title-block {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-inline-size: 60rem;
    padding-block-start: clamp(4rem, 12vw, 9rem);
  }
  .post-kicker,
  .post-meta {
    color: var(--fg-2);
  }
  .post-title {
    max-inline-size: 20ch;
  }
  .post-image {
    padding-block-start: 3rem;
  }
  .post-image :global(.post-photo) {
    inline-size: 100%;
    border-radius: var(--radius-sm);
  }
  .post-prose {
    margin-inline: auto;
  }
  .post-cta {
    background-color: var(--bg);
    color: var(--fg);
  }
  .post-cta-inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }
  .post-cta-title {
    font-size: var(--text-display-m);
    line-height: var(--lh-display-m);
  }
  .post-more :global(.text-link) {
    margin-block-start: 2rem;
  }
  .post-related-title {
    font-size: var(--text-h3);
    margin-block-end: 1rem;
  }
  .post-related-list {
    border-block-start: 1px solid var(--line);
  }
</style>

<script>
  import { scene } from '../../../lib/motion/scenes';
  const article = document.querySelector<HTMLElement>('[data-post]');
  const bar = document.querySelector<HTMLElement>('[data-read-progress]');
  if (article && bar) {
    scene(article, 'pin', (p) => bar.style.setProperty('--p', p.toFixed(4)));
  }
</script>
