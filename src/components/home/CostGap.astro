---
import SourceNote from '../ui/SourceNote.astro';
import { problemStats } from '../../data/stats';
import { formatPercent } from '../../lib/format';
import type { Locale } from '../../i18n/config';

/**
 * What sending money actually costs, against what the world agreed it
 * should cost.
 *
 * Two of the three sourced figures in src/data/stats.ts measure the same
 * thing — the cost of a cross-border transfer — so as two separate stat
 * tiles they made the reader do the arithmetic. Here the bar is today's
 * cost, decomposed: the recessive part is the UN's 2030 target, the solid
 * part is everything charged above it. More than half the bar is the part
 * that should not be there, and that is the argument for the product.
 *
 * Form: a ratio against a limit, so one mark on a single-hue ramp — navy at
 * two steps, no second colour, nothing to mistake under colour-blindness.
 * Text never wears the data colour; the segments carry it and the labels
 * stay in ink.
 *
 * Drawn as SVG geometry rather than CSS widths on purpose: the site's CSP
 * has no 'unsafe-inline' for styles, so a `style="width:47%"` would not
 * paint (and scripts/check-dist.mjs fails the build on one). Presentation
 * attributes inside an <svg> are not affected.
 *
 * Nothing here is a Shaheen Money price. It is the global average and the
 * UN target, both sourced and dated below the bar.
 */
interface Props {
  locale: Locale;
  title: string;
  targetLabel: string;
  excessLabel: string;
  totalLabel: string;
  /** Plain-language description of the bar, for screen readers. */
  alt: (actual: string, target: string) => string;
  class?: string;
}
const { locale, title, targetLabel, excessLabel, totalLabel, alt, class: className } = Astro.props;

const actual = problemStats.find((s) => s.id === 'global-cost');
const target = problemStats.find((s) => s.id === 'sdg-target');

// Geometry. The bar's full width is today's cost, so nothing invents a
// ceiling: the split is the only claim being made.
const W = 640;
const H = 28;
const R = 4;
const GAP = 2;

const share = actual && target ? target.value / actual.value : 0;
const targetW = Math.max(0, W * share - GAP / 2);
const excessX = targetW + GAP;
const excessW = Math.max(0, W - excessX);

/** A bar squared at the baseline and rounded at the data end. */
const roundedEnd = (x: number, w: number) =>
  `M${x} 0 H${x + w - R} a${R} ${R} 0 0 1 ${R} ${R} V${H - R} a${R} ${R} 0 0 1 -${R} ${R} H${x} Z`;
const squared = (x: number, w: number) => `M${x} 0 h${w} v${H} h-${w} Z`;

const excess = actual && target ? actual.value - target.value : 0;
---

{
  actual && target && (
    <figure class:list={['flex flex-col gap-4', className]} data-reveal>
      <figcaption class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
        <span class="text-body font-semibold text-fg">{title}</span>
        <span class="num text-display-lg font-display text-fg">{actual.display}</span>
      </figcaption>

      <svg
        class="cost-bar"
        viewBox={`0 0 ${W} ${H}`}
        role="img"
        aria-label={alt(actual.display, target.display)}
        focusable="false"
      >
        <path class="cost-target" d={squared(0, targetW)} />
        <path class="cost-excess" d={roundedEnd(excessX, excessW)} />
      </svg>

      <ul class="flex flex-wrap gap-x-8 gap-y-2">
        <li class="flex items-center gap-2 text-body-sm text-fg-2">
          <span class="cost-key cost-key-target" aria-hidden="true" />
          {targetLabel} <span class="num font-semibold text-fg">{target.display}</span>
        </li>
        <li class="flex items-center gap-2 text-body-sm text-fg-2">
          <span class="cost-key cost-key-excess" aria-hidden="true" />
          {excessLabel}{' '}
          <span class="num font-semibold text-fg">{formatPercent(Math.round(excess * 100) / 100, locale)}</span>
        </li>
      </ul>

      <p class="measure text-body text-fg-2">{totalLabel}</p>

      <div class="flex flex-col gap-1">
        <SourceNote source={actual.source} locale={locale} />
        <SourceNote source={target.source} locale={locale} />
      </div>
    </figure>
  )
}

<style>
  .cost-bar {
    inline-size: 100%;
    block-size: auto;
    /* A quantity reads from the start of the line, so unlike the globe this
       one does mirror in Arabic. */
    display: block;
  }
  :global([dir='rtl']) .cost-bar {
    transform: scaleX(-1);
  }

  /* The excess grows out of the target rather than arriving drawn. The
     motion is the argument: the reader watches the bar pass the line the
     world agreed on and keep going. It runs once, on the same reveal that
     brings the figure in, and it cannot strand the bar empty — without
     the script there is no pending state and the segment is simply there.

     transform-box: fill-box makes the origin the segment's own left edge,
     which stays correct under the RTL mirror applied to the whole svg. */
  .cost-excess {
    transform-box: fill-box;
    transform-origin: left center;
  }
  [data-reveal-pending] .cost-excess {
    transform: scaleX(0);
  }
  [data-revealed] .cost-excess {
    transform: scaleX(1);
    transition: transform 1s var(--ease-out) 0.15s;
  }
  @media (prefers-reduced-motion: reduce) {
    [data-reveal-pending] .cost-excess,
    [data-revealed] .cost-excess {
      transform: none;
      transition: none;
    }
  }

  /* One hue, two steps: the recessive part is what the cost should be, the
     solid part is what is charged above it. The ink is on the problem. */
  .cost-target {
    fill: color-mix(in srgb, var(--color-navy) 22%, transparent);
  }
  .cost-excess {
    fill: var(--color-navy);
  }

  .cost-key {
    inline-size: 0.75rem;
    block-size: 0.75rem;
    border-radius: var(--radius-sm);
    flex: none;
  }
  .cost-key-target {
    background-color: color-mix(in srgb, var(--color-navy) 22%, transparent);
  }
  .cost-key-excess {
    background-color: var(--color-navy);
  }

  /* Forced colours: fills are replaced by the user's palette, so give the
     two segments an outline to stay distinguishable. */
  @media (forced-colors: active) {
    .cost-target,
    .cost-excess {
      stroke: currentColor;
      stroke-width: 1;
    }
  }
</style>
