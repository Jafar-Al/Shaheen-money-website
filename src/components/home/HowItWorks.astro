---
import Section from '../ui/Section.astro';
import Journey from './Journey.astro';
import Icon from '../ui/Icon.astro';
import Gap from '../ui/Gap.astro';
import SourceNote from '../ui/SourceNote.astro';
import { home } from '../../copy/home';
import { facts } from '../../data/facts';
import type { Locale } from '../../i18n/config';

/**
 * What the app does, said once, for the visitor who wants to understand
 * before installing anything. Carries what used to be /how-it-works: the
 * four steps, the three things worth knowing, and who it is for.
 *
 * The four steps are drawn as one connected journey (Journey.astro): money
 * enters at the first node and leaves as cash at the last, which is the
 * whole argument, so the line that carries it is the picture.
 *
 * No mock app screens and no invented transactions: the old site's
 * "+ $1,240.00 from a client in Berlin" cards were props, and a wallet that
 * shows people fake balances has not earned the first install.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = home[locale].steps;
const dollar = facts.digitalDollar;
---

<Section id="how" tone="subtle" labelledby="how-title">
  <header class="flex max-w-2xl flex-col gap-5">
    <p class="text-label uppercase text-navy">{t.label}</p>
    <h2 id="how-title" class="text-h1 font-display">{t.title}</h2>
    <p class="measure text-body-lg text-fg-2">{t.lead}</p>
  </header>

  <Journey items={t.items} locale={locale} class="mt-12" />

  <div class="mt-16 grid gap-10 lg:grid-cols-12 lg:gap-8" data-reveal>
    <div class="flex flex-col gap-6 lg:col-span-7">
      <h3 class="text-h3 font-display">{t.goodToKnow}</h3>
      <ul class="flex flex-col gap-5">
        {
          t.facts.map((f) => (
            <li class="flex items-start gap-3">
              <Icon name="check" size={22} class="mt-1 shrink-0 text-navy" />
              <span class="flex flex-col gap-1">
                <span class="text-body font-semibold">{f.title}</span>
                <span class="text-body-sm text-fg-2">{f.body}</span>
              </span>
            </li>
          ))
        }
      </ul>
      {
        dollar ? (
          <div class="flex flex-col gap-2 border-s-2 border-navy ps-5">
            <p class="measure text-body text-fg">{dollar.value[locale]}</p>
            <SourceNote source={dollar.source} locale={locale} />
          </div>
        ) : (
          <Gap need="What a digital dollar is and what backs it, in one paragraph, in both languages. The single most asked question about the product, and a launch blocker (audit B.2)." />
        )
      }
    </div>

    <div class="flex flex-col gap-6 rounded-lg border border-line bg-white p-6 shadow-sm md:p-8 lg:col-span-5" data-card>
      <h3 class="text-h3 font-display">{t.audiencesTitle}</h3>
      <ul class="flex flex-col gap-5">
        {
          t.audiences.map((a) => (
            <li class="flex flex-col gap-1">
              <span class="text-body font-semibold">{a.title}</span>
              <span class="text-body-sm text-fg-2">{a.body}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
