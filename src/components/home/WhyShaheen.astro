---
import { figureHTML } from '../../lib/figure';
import Chapter from '../ui/Chapter.astro';
import Emph from '../ui/Emph.astro';
import Figure from '../ui/Figure.astro';
import FootnoteRef from '../ui/FootnoteRef.astro';
import SourceNote from '../ui/SourceNote.astro';
import Slip from '../ui/Slip.astro';
import Stamp from '../ui/Stamp.astro';
import { home } from '../../copy/home';
import { common } from '../../copy/common';
import { problemStats } from '../../data/stats';
import { formatPercent } from '../../lib/format';
import { cities } from '../../data/network-map';
import { coords } from '../../lib/atlas';
import type { Locale } from '../../i18n/config';

/**
 * 01 — Why. The cost of the status quo, as a numbers scene.
 *
 * Two of the three sourced figures in src/data/stats.ts measure the same
 * thing (the cost of a cross-border transfer), so they are one instrument:
 * an engraved ruler from 0 to today's 6.36%, the UN's 2030 target cut into
 * it at 3%, and everything charged above the target drawn as a solid bar
 * that fills as the ruler scrolls through the screen. More than half the
 * bar should not be there; the motion is that argument.
 *
 * Every figure keeps its source as a numbered footnote directly beneath it.
 * None of them is a Shaheen Money price, and the section says so.
 */
interface Props {
  locale: Locale;
  n: number;
}
const { locale, n } = Astro.props;
const t = home[locale].why;
const ui = common[locale].ui;

const actual = problemStats.find((s) => s.id === 'global-cost')!;
const target = problemStats.find((s) => s.id === 'sdg-target')!;
const lebanon = problemStats.find((s) => s.id === 'lebanon-no-account');
const excess = Math.round((actual.value - target.value) * 100) / 100;

// The ruler, in a 1000-unit line from 0% to today's figure. A quantity
// reads from the start of the line, so in Arabic the positions are mirrored
// here (the text inside the SVG is not).
const rtl = locale === 'ar';
const at = (v: number) => {
  const x = (v / actual.value) * 1000;
  return rtl ? 1000 - x : x;
};
const ticks = Array.from({ length: Math.floor(actual.value) + 1 }, (_, i) => i);
const targetX = at(target.value);
const barX = rtl ? 0 : targetX;
const barW = rtl ? targetX : 1000 - targetX;
const labelAnchor = rtl ? 'start' : 'end';
---

<section id="why" class="why t-night grain" data-temp="night" aria-labelledby="why-title">
  <div class="page rhythm why-grid">
    <header class="why-head">
      <Chapter n={n} label={t.label} />
      <h2 id="why-title" class="text-display-l font-display"><Emph text={t.title} /></h2>
      <p class="lead">{t.lead}</p>
    </header>

    <figure class="why-cost" data-reveal data-why-ruler>
      <figcaption class="why-cost-title">{t.cost.title}</figcaption>
      <p class="why-cost-figure num">
        <span class="sr-only">{actual.display}</span>
        <span aria-hidden="true" data-count={actual.display} data-count-punct set:html={figureHTML(actual.display)} /><FootnoteRef n={1} label={ui.source} />
      </p>

      <svg
        class="ruler"
        viewBox="-12 0 1024 120"
        role="img"
        aria-label={t.cost.alt(actual.display, target.display)}
        focusable="false"
      >
        <line class="ruler-base" x1="0" y1="60" x2="1000" y2="60" />
        {
          ticks.map((v) => (
            <g class="ruler-tick">
              <line x1={at(v)} y1="52" x2={at(v)} y2="68" />
              <text x={at(v)} y="92" text-anchor="middle">
                {v}%
              </text>
            </g>
          ))
        }
        <line class="ruler-end" x1={at(actual.value)} y1="34" x2={at(actual.value)} y2="68" />
        <rect class="ruler-over" x={barX} y="54" width={barW} height="12" />
        <line class="ruler-target" x1={targetX} y1="14" x2={targetX} y2="76" />
        <text class="ruler-note" x={targetX + (rtl ? 10 : -10)} y="24" text-anchor={labelAnchor}>
          {t.cost.target} · {target.display}
        </text>
        <text class="ruler-note ruler-note-over" x={rtl ? 0 : 1000} y="24" text-anchor={rtl ? 'start' : 'end'}>
          {t.cost.excess} · {formatPercent(excess, locale)}
        </text>
      </svg>

      <ul class="ruler-legend" aria-hidden="true">
        <li><span class="ruler-key ruler-key-target"></span>{t.cost.target} · <span class="num">{target.display}</span></li>
        <li><span class="ruler-key ruler-key-over"></span>{t.cost.excess} · <span class="num">{formatPercent(excess, locale)}</span></li>
      </ul>
      <p class="why-cost-total">{t.cost.total}</p>
      <div class="why-sources">
        <SourceNote source={actual.source} locale={locale} n={1} />
        <SourceNote source={target.source} locale={locale} n={2} />
      </div>
    </figure>

    {
      lebanon && (
        <Figure
          stat={lebanon}
          display={lebanon.display}
          label={lebanon.label[locale]}
          locale={locale}
          n={3}
          class="why-lebanon"
        />
      )
    }

    <Slip no={cities.amman.name[locale]} meta={coords(cities.amman.lon, cities.amman.lat)} metaData class="why-example" data-reveal>
      <Stamp locale={locale} kind="example" tilt={2} class="why-example-stamp" />
      <p class="why-example-text">{t.example}</p>
      <p class="why-example-sum num" lang="en" dir="ltr">
        $300 × {actual.display} ≈ $19 <span aria-hidden="true">·</span> × 12 &gt; $220
      </p>
    </Slip>
  </div>
</section>

<style>
  .why {
    background-color: var(--bg);
    color: var(--fg);
    border-block-start: 1px solid var(--line);
  }
  .why-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: clamp(4rem, 9vw, 8rem);
  }
  .why-head {
    grid-column: 1 / span 9;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }
  .why-head h2 {
    max-inline-size: 15ch;
  }

  /* 6.36%: hangs from the left, the ruler runs the full width under it. */
  .why-cost {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    align-items: end;
    gap: 1.5rem var(--gutter);
    margin: 0;
  }
  .why-cost-title {
    grid-column: 2;
    grid-row: 1;
    align-self: end;
    max-inline-size: 26ch;
    padding-block-end: 1.25rem;
    font-size: var(--text-body-l);
    line-height: var(--lh-body-l);
    color: var(--fg-2);
  }
  .why-cost-figure {
    grid-column: 1;
    grid-row: 1;
    display: flex;
    align-items: flex-start;
    font-size: var(--text-figure);
    line-height: var(--lh-figure);
    letter-spacing: var(--ls-figure);
    white-space: nowrap;
  }
  .why-cost-figure :global(.fnref) {
    margin-block-start: 0.4em;
    font-size: 0.75rem;
    letter-spacing: 0;
  }
  .ruler {
    grid-column: 1 / -1;
    inline-size: 100%;
    block-size: auto;
    overflow: visible;
    direction: ltr;
  }
  .ruler-base,
  .ruler-tick line,
  .ruler-end {
    stroke: var(--fg-2);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .ruler-end {
    stroke: var(--fg);
  }
  .ruler-tick text,
  .ruler-note {
    fill: var(--fg-2);
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
  }
  :global(:lang(ar)) .ruler-note {
    font-family: var(--font-plex-arabic), var(--font-mono);
    font-size: 15px;
    letter-spacing: 0;
  }
  .ruler-note-over {
    fill: var(--fg);
  }
  .ruler-target {
    stroke: var(--accent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  /* The part charged above the target fills as the ruler moves up the
     screen (--p from the scene); at rest it is simply full. */
  .ruler-over {
    fill: var(--fg);
    transform-box: fill-box;
    transform-origin: left center;
    scale: var(--fill, 1) 1;
  }
  :global([dir='rtl']) .ruler-over {
    transform-origin: right center;
  }
  .why-cost-total {
    grid-column: 1;
    max-inline-size: 44ch;
    font-size: var(--text-body);
    color: var(--fg-2);
  }
  .why-sources {
    grid-column: 2;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* 77%: hangs from the right, against the first figure. */
  .why-grid :global(.why-lebanon) {
    grid-column: 6 / -1;
  }

  .why-grid :global(.why-example) {
    grid-column: 1 / span 5;
    grid-row: 4;
    align-self: start;
    rotate: -1.2deg;
  }
  .why-grid :global(.why-lebanon) {
    grid-row: 3 / span 2;
  }
  .why-example-text {
    font-size: var(--text-body);
    line-height: var(--lh-body);
  }
  .why-example-sum {
    margin-block-start: 1rem;
    padding-block-start: 0.875rem;
    border-block-start: 1px dashed var(--line-strong);
    font-size: var(--text-label);
    color: var(--fg-2);
  }
  .why-example :global(.why-example-stamp) {
    position: absolute;
    inset-block-start: 0.75rem;
    inset-inline-end: 1rem;
  }

  .ruler-legend {
    display: none;
  }
  @media (width < 48rem) {
    /* The ruler's own labels would be a few pixels tall here: they move out
       of the drawing into a legend under it. */
    .ruler-tick text,
    .ruler-note {
      display: none;
    }
    .ruler-legend {
      grid-column: 1 / -1;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-size: var(--text-body-s);
      color: var(--fg-2);
    }
    .ruler-legend li {
      display: flex;
      align-items: center;
      gap: 0.625rem;
    }
    .ruler-key {
      inline-size: 1.25rem;
      block-size: 0.5rem;
      border: 1px solid var(--fg);
    }
    .ruler-key-target {
      block-size: 0;
      border-width: 0 0 0 2px;
      border-color: var(--accent);
      inline-size: 0;
      padding-block: 0.4rem;
    }
    .ruler-key-over {
      background-color: var(--fg);
    }
  }
  @media (width < 64rem) {
    .why-head,
    .why-grid :global(.why-lebanon),
    .why-grid :global(.why-example) {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .why-cost {
      grid-template-columns: minmax(0, 1fr);
    }
    .why-cost-title,
    .why-cost-figure,
    .why-cost-total,
    .why-sources {
      grid-column: 1;
      grid-row: auto;
    }
    .why-cost-figure {
      font-size: 22vw;
    }
    .why-grid :global(.why-example) {
      max-inline-size: 30rem;
    }
  }
  @media (width < 48rem) {
    .why-grid :global(.why-lebanon .figure-num) {
      font-size: 22vw;
    }
  }
</style>

<script>
  import { scene } from '../../lib/motion/scenes';
  import { onReveal } from '../../lib/motion/reveal';
  import { motionLevel, scrubbing } from '../../lib/motion/level';

  // Scrubbed on a desktop; on a phone, and for reduced motion, it fills
  // once as it lands (or is simply full).
  const ruler = document.querySelector<HTMLElement>('[data-why-ruler]');
  const bar = ruler?.querySelector<SVGElement>('.ruler-over');
  if (ruler && bar && motionLevel() !== 'reduced') {
    if (scrubbing()) {
      scene(ruler, 'enter', (p) => {
        const fill = Math.min(1, Math.max(0, (p - 0.35) / 0.45));
        bar.style.setProperty('--fill', fill.toFixed(3));
      });
    } else {
      bar.style.setProperty('--fill', '0');
      bar.style.transition = 'scale 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.2s';
      onReveal(ruler, () => bar.style.setProperty('--fill', '1'));
    }
  }
</script>
