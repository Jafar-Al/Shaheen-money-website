---
import Chapter from '../ui/Chapter.astro';
import Emph from '../ui/Emph.astro';
import Accordion from '../ui/Accordion.astro';
import TextLink from '../ui/TextLink.astro';
import { home } from '../../copy/home';
import { common } from '../../copy/common';
import { href, type Locale, type PageKey } from '../../i18n/config';

/**
 * 05 — The questions we are asked most. Was /help.
 *
 * Native <details>: keyboard and screen-reader support without a line of
 * JavaScript, and the answers are in the HTML whether or not anyone opens
 * them. The page emits matching FAQPage structured data (index.astro),
 * which is honest only because the answer a search engine reads is the
 * answer a visitor reads.
 */
interface Props {
  locale: Locale;
  n: number;
}
const { locale, n } = Astro.props;
const t = home[locale].faq;
const nav = common[locale].nav;

const labels: Record<'security' | 'getApp' | 'contact' | 'business', string> = {
  security: nav.security,
  getApp: nav.getApp,
  contact: nav.contact.title,
  business: nav.business.title,
};

const items = t.items.map((item) => ({
  q: item.q,
  a: item.a,
  link: 'link' in item && item.link ? { href: href(locale, item.link as PageKey), label: labels[item.link] } : undefined,
}));
---

<section id="faq" class="faq t-paper grain cv-auto" data-temp="paper" aria-labelledby="faq-title">
  <div class="page rhythm faq-grid">
    <header class="faq-head">
      <Chapter n={n} label={t.label} />
      <h2 id="faq-title" class="text-display-l font-display"><Emph text={t.title} /></h2>
      <p class="faq-help">
        <span>{t.stillTitle}</span>
        <TextLink href={href(locale, 'contact')}>{t.stillCta}</TextLink>
      </p>
    </header>

    <div class="faq-list">
      <Accordion items={items} />
    </div>
  </div>
</section>

<style>
  .faq {
    background-color: var(--bg);
    color: var(--fg);
  }
  .faq-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 3rem;
    align-items: start;
    padding-block: var(--section);
  }
  .faq-head {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  @media (width >= 64rem) {
    .faq-head {
      position: sticky;
      inset-block-start: calc(var(--header-h) + 2rem);
    }
  }
  .faq-head h2 {
    max-inline-size: 10ch;
  }
  .faq-help {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1rem;
    color: var(--fg-2);
  }
  .faq-list {
    grid-column: 6 / -1;
  }
  @media (width < 64rem) {
    .faq-head,
    .faq-list {
      grid-column: 1 / -1;
    }
  }
</style>
