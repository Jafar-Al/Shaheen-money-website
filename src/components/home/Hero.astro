---
// In the browser: src/scripts/home/hero.ts (loaded once by the homepage).
import FalconFlight from './FalconFlight.astro';
import HeroAtlas from './HeroAtlas.astro';
import DownloadButton from '../site/DownloadButton.astro';
import Button from '../ui/Button.astro';
import Gap from '../ui/Gap.astro';
import { home } from '../../copy/home';
import { facts } from '../../data/facts';
import { FRAMES } from '../../lib/atlas';
import { formatNumber, formatUsd } from '../../lib/format';
import { href, type Locale } from '../../i18n/config';
import { common } from '../../copy/common';

/**
 * The first screen: "The Unfurl".
 *
 * The falcon (FalconFlight.astro, untouched) stoops in from the upper left
 * and lands on Amman on a quiet map: the land a soft tone on navy, only the
 * five corridor cities named. As it settles, each of its five feathers
 * draws out into the great circle it flew in on (Toronto, New York, London,
 * Paris, Berlin) and a first transfer runs down a route into the falcon.
 *
 * The headline, the line under it and both controls are in the HTML and
 * visible from the first frame (no script, no wait on the art): LCP is the
 * headline. Everything behind them is decorative, aria-hidden, and dropped
 * in forced colours. Reduced motion renders the final state.
 *
 * Composition: art across the top band, words across the bottom. In
 * Arabic the words move to the right; the map does not mirror, because
 * geography does not.
 */
interface Props {
  locale: Locale;
  /** How many chapters the page has: the scroll cue counts them. */
  chapters: number;
}
const { locale, chapters } = Astro.props;
const t = home[locale].hero;

/* The falcon's box is set in CSS below in round percentages of each frame;
   these must be the same numbers as src/lib/atlas.ts FRAMES. */
const CSS_FALCON = { wide: { x: 50, y: 17, w: 15 }, tall: { x: 30, y: 14, w: 46 } };
for (const id of ['wide', 'tall'] as const) {
  const a = FRAMES[id].falcon;
  const b = CSS_FALCON[id];
  if (a.x !== b.x || a.y !== b.y || a.w !== b.w) {
    throw new Error(`Hero: the falcon box for the ${id} frame differs between src/lib/atlas.ts and Hero.astro's CSS.`);
  }
}

const evidence: Array<{ label: string; href: string }> = [];
if (facts.network.countries)
  evidence.push({ label: t.evidence.countries(formatNumber(facts.network.countries.value, locale)), href: href(locale, 'contact') });
if (facts.pricing.minCashOutUsd)
  evidence.push({ label: t.evidence.minCashOut(formatUsd(facts.pricing.minCashOutUsd.value, locale)), href: '#pricing' });
if (facts.network.activeConnectors)
  evidence.push({ label: t.evidence.connectors(formatNumber(facts.network.activeConnectors.value, locale)), href: '#network' });
if (facts.pricing.noFxMargin) evidence.push({ label: t.evidence.noFxMargin, href: '#pricing' });

/** "Money without borders." → ["Money without ", "borders."]: the last word is the emphasised one. */
const split = (line: string) => {
  const i = line.lastIndexOf(' ');
  return [line.slice(0, i + 1), line.slice(i + 1)] as const;
};
---

<section class="hero t-night under-header" data-temp="night" aria-labelledby="hero-title" data-hero>
  <div class="page hero-content">
    <p class="hero-marks label">{common[locale].ui.stamp.corridors}</p>

    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title">
        {
          t.title.map((line, i) => {
            const [lead, word] = split(line);
            return (
              <span class={`hero-line hero-line-${i}`}>
                <span class="hero-line-inner">
                  {lead}
                  <em class="emph">{word}</em>
                </span>{' '}
              </span>
            );
          })
        }
      </h1>
      <p class="hero-sub">{t.subtitle}</p>
      <div class="hero-actions">
        <DownloadButton locale={locale} />
        <Button href="#how" variant="line" arrow="down">{t.explore}</Button>
        <p class="hero-avail label">{t.availability}</p>
      </div>
      {
        evidence.length > 0 ? (
          <ul class="hero-evidence">
            {evidence.map((e) => (
              <li>
                <a href={e.href} class="ink-link">
                  {e.label}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <Gap need="Optional evidence row under the buttons: countries live, minimum cash-out, active Connectors, FX policy. Each sourced and dated; unsourced items never render." />
        )
      }
    </div>

    <a href="#why" class="hero-scroll label">
      <span>{t.more}</span>
      <span class="hero-scroll-rule" aria-hidden="true"></span>
      <span class="num" aria-hidden="true">01/{String(chapters).padStart(2, '0')}</span>
    </a>
  </div>

  {/* The art follows the words in the source: the headline (the page's
       largest paint) arrives before the map's bytes. Stacking is by z-index. */}
  <div class="hero-art" aria-hidden="true" data-art data-ambient>
    <div class="hero-zoom">
      <div class="hero-stage stage-wide"><HeroAtlas frame="wide" locale={locale} /></div>
      <div class="hero-stage stage-tall"><HeroAtlas frame="tall" locale={locale} /></div>
      <div class="hero-stage stage-falcon">
        <div class="hero-falcon" data-parallax="6">
          <FalconFlight />
        </div>
      </div>
    </div>
    <div class="hero-vignette"></div>
  </div>
</section>

<style>
  /* ── Frame ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-block-size: max(calc(100svh - var(--strip-h)), 40rem);
    overflow: clip;
    /* The brand navy, a step softer than the Night below it; the vignette
       at the foot fades into --bg, so the two meet without an edge. */
    background-color: var(--color-navy-800);
    color: var(--fg);
  }
  .hero-art {
    position: absolute;
    inset: 0;
    container-type: size;
    pointer-events: none;
    /* The header sits over the top of the map: the art thins out under it. */
    mask-image: linear-gradient(to bottom, rgb(0 0 0 / 0.2) 0, rgb(0 0 0 / 0.2) calc(var(--header-h) - 1.5rem), #000 calc(var(--header-h) + 3rem));
  }
  /* Legibility guard: route lines and place names dissolve where the words
     sit (lower left, or lower right in Arabic). No glow, no box. */
  .hero-art :global(.atlas-lines) {
    mask-image: radial-gradient(ellipse 58% 42% at 22% 82%, rgb(0 0 0 / 0.1) 55%, #000 100%);
  }
  :global([dir='rtl']) .hero-art :global(.atlas-lines) {
    mask-image: radial-gradient(ellipse 58% 42% at 78% 82%, rgb(0 0 0 / 0.1) 55%, #000 100%);
  }
  .hero-zoom {
    position: absolute;
    inset: 0;
    transform-origin: var(--ox) var(--oy);
  }
  /* Scroll-out: the map closes in on Amman as the hero leaves (--p from the
     exit scene); every layer scales together, so the routes stay on their
     cities and the falcon on its city. The scale is only applied while the
     hero is actually leaving: at rest it is `none`, which also makes
     Chromium repaint the SVG labels it can otherwise leave stale after a
     zoom. */
  .hero[data-zoom] .hero-zoom {
    scale: calc(1 + var(--p, 0) * 0.25);
  }

  /*
   * The stages. Each has its frame's aspect ratio. On a tablet and up the
   * stage is sized by the hero's height (so the falcon sits at the same
   * height on every screen) and slid sideways so Amman is at 66% of the
   * width; the map, the routes and the graticule run on past the stage's
   * edges (overflow: visible), so wider screens simply see more of the
   * world. The map, the routes and the falcon share one stage box, so a
   * feather tip and the start of its route are the same point at any size.
   * Physical left/top: the map does not mirror in Arabic.
   */
  .hero-stage {
    --H: calc(100cqh * 1.05);
    --W: calc(var(--H) * 1.6);
    position: absolute;
    /* 0.628125 is Amman's x in the wide frame (src/lib/atlas.ts). */
    left: calc(66cqw - var(--W) * 0.628125);
    top: calc(100cqh * -0.025);
    inline-size: var(--W);
    block-size: var(--H);
  }
  .hero-zoom {
    /* Amman, in the hero: 66% across, and 39.6% down a stage that starts
       2.5% above the top and is 105% tall. */
    --ox: 66cqw;
    --oy: calc(100cqh * (0.396 * 1.05 - 0.025));
  }
  .stage-tall {
    display: none;
  }
  /* Falcon: the same round numbers as FRAMES.wide.falcon in src/lib/atlas.ts. */
  .hero-falcon {
    position: absolute;
    left: 50%;
    top: 17%;
    inline-size: 15%;
    transition: translate 1.2s var(--ease-out);
  }
  .hero-falcon :global(.falcon-stage) {
    inline-size: 100%;
  }

  @media (width < 48rem) {
    .stage-wide {
      display: none;
    }
    .stage-tall {
      display: block;
    }
    .hero-stage {
      --W: max(100cqw, 46.51cqh);
      --H: calc(var(--W) * 2.15);
      left: calc((100cqw - var(--W)) / 2);
      top: calc((100cqh - var(--H)) / 2.6);
    }
    .hero-zoom {
      --ox: calc((100cqw - max(100cqw, 46.51cqh)) / 2 + max(100cqw, 46.51cqh) * 0.6929);
      --oy: calc((100cqh - max(100cqw, 46.51cqh) * 2.15) / 2.6 + max(100cqw, 46.51cqh) * 2.15 * 0.3415);
    }
    /* Falcon: FRAMES.tall.falcon. */
    .hero-falcon {
      left: 30%;
      top: 14%;
      inline-size: 46%;
    }
  }

  /* Keeps the words legible where they cross the map: a quiet darkening
     at the foot of the frame, no glow and no box. */
  .hero-vignette {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--bg) 0%, color-mix(in srgb, var(--bg) 70%, transparent) 24%, transparent 52%);
  }

  /* ── Words ─────────────────────────────────────────────────────────── */
  .hero-content {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-rows: auto 1fr auto;
    flex: 1;
    padding-block: calc(var(--header-h) + 1.25rem) 1.5rem;
  }
  /* The map's note stays on the map's side in both languages. */
  .hero-marks {
    justify-self: right;
    color: var(--fg-3);
    opacity: 0;
    animation: marks-in 0.8s var(--ease-out) 3.3s forwards;
  }
  @keyframes marks-in {
    from {
      opacity: 0;
      translate: 0 -6px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .hero-copy {
    align-self: end;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .hero-title {
    /* Capped, so an ultra-wide screen still sets each sentence on one line
       inside the page's measure. */
    font-size: min(7.2vw, 13.5svh, 8.5rem);
    line-height: var(--lh-display-xl);
    letter-spacing: var(--ls-display-xl);
    color: var(--fg);
  }
  :global(:lang(ar)) .hero-title {
    font-size: min(6.4vw, 12svh, 7.5rem);
    font-weight: 500;
  }
  @media (width >= 48rem) and (orientation: portrait) {
    .hero-title {
      font-size: 9vw;
    }
    :global(:lang(ar)) .hero-title {
      font-size: 8vw;
    }
  }
  .hero-line {
    display: block;
    clip-path: inset(-0.3em -0.1em -0.35em);
  }
  .hero-line-inner {
    display: inline-block;
    animation: line-up 1s var(--ease-out) both;
  }
  .hero-line-1 .hero-line-inner {
    animation-delay: 0.12s;
  }
  /* Visible from the first frame (the headline is the page's largest
     paint): the lines rise into place, they never appear from nothing. */
  @keyframes line-up {
    from {
      opacity: 0.35;
      translate: 0 0.3em;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }
  .hero-sub {
    max-inline-size: 34rem;
    font-size: var(--text-body-l);
    line-height: var(--lh-body-l);
    color: var(--fg-2);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .hero-avail {
    margin-inline-start: 0.75rem;
    color: var(--fg-3);
  }
  .hero-evidence {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--text-body-s);
    color: var(--fg-2);
  }

  .hero-scroll {
    display: none;
    align-items: center;
    gap: 0.75rem;
    justify-self: start;
    min-block-size: var(--target-min);
    margin-block-start: 1.5rem;
    color: var(--fg-2);
  }
  .hero-scroll:hover {
    color: var(--fg);
  }
  @media (height >= 50rem) and (width >= 48rem) {
    .hero-scroll {
      display: inline-flex;
    }
  }
  .hero-scroll-rule {
    inline-size: 3rem;
    block-size: 1px;
    background-color: var(--line-strong);
  }

  /* ── Tablet and phone ──────────────────────────────────────────────── */
  @media (width < 64rem) {
    .hero-marks {
      display: none;
    }
    /* Without the marks the words would rise into the first row, under the
       falcon: two rows keep them at the foot of the hero. */
    .hero-content {
      grid-template-rows: 1fr auto;
    }
  }
  @media (width < 48rem) {
    .hero {
      min-block-size: max(100svh, 40rem);
    }
    .hero-content {
      grid-template-rows: 1fr auto;
      padding-block-end: 1rem;
    }
    .hero-title {
      font-size: 12.5vw;
    }
    :global(:lang(ar)) .hero-title {
      font-size: 11vw;
    }
    /* On a phone the two sentences run on as one paragraph: three lines. */
    .hero-line {
      display: inline;
      clip-path: none;
    }
    .hero-line-inner {
      display: inline;
      animation: none;
    }
    .hero-copy {
      gap: 1.125rem;
    }
    .hero-sub {
      font-size: var(--text-body);
    }
    .hero-actions {
      flex-direction: column;
      align-self: stretch;
    }
    .hero-actions :global(.btn),
    .hero-actions :global(.dl-button) {
      inline-size: 100%;
    }
    .hero-scroll {
      display: none;
    }
    .hero-avail {
      margin-inline-start: 0;
      align-self: center;
    }
  }
  @media (height <= 44rem) and (width >= 48rem) {
    .hero-copy {
      gap: 1rem;
    }
  }
  /* A phone on its side: the hero fits the screen instead of a 40rem
     minimum. The wide map, with Amman pushed to the far side (the right, or
     the left in Arabic), so the headline, kept to the other 58%, never meets
     the falcon. The line under it and the buttons sit below the falcon and
     may run wider. */
  @media (orientation: landscape) and (height < 32rem) {
    .hero {
      min-block-size: max(calc(100svh - var(--strip-h)), 18rem);
    }
    .stage-wide {
      display: block;
    }
    .stage-tall {
      display: none;
    }
    .hero-zoom {
      /* Amman's place across the hero. */
      --ax: 78cqw;
      --ox: var(--ax);
      --oy: calc(100cqh * (0.396 * 1.05 - 0.025));
    }
    :global([dir='rtl']) .hero-zoom {
      --ax: 30cqw;
    }
    .hero-stage {
      --H: calc(100cqh * 1.05);
      --W: calc(var(--H) * 1.6);
      left: calc(var(--ax) - var(--W) * 0.628125);
      top: calc(100cqh * -0.025);
    }
    .hero-falcon {
      left: 50%;
      top: 17%;
      inline-size: 15%;
    }
    .hero-content {
      grid-template-rows: 1fr auto;
      padding-block-end: 1rem;
    }
    .hero-copy {
      gap: 0.75rem;
    }
    .hero-title {
      max-inline-size: 58%;
      font-size: min(5.6vw, 12svh);
    }
    :global(:lang(ar)) .hero-title {
      font-size: min(5vw, 10.5svh);
    }
    .hero-line {
      display: block;
    }
    .hero-sub {
      max-inline-size: 34em;
      font-size: var(--text-body-s);
    }
    .hero-actions {
      flex-direction: row;
      align-self: auto;
    }
    .hero-actions :global(.btn),
    .hero-actions :global(.dl-button) {
      inline-size: auto;
    }
    .hero-scroll,
    .hero-marks {
      display: none;
    }
  }
  /* The smallest phones on their side: room for the buttons, not the note. */
  @media (orientation: landscape) and (height < 22rem) {
    .hero-content {
      padding-block-start: calc(var(--header-h) + 0.25rem);
    }
    .hero-copy {
      gap: 0.5rem;
    }
    .hero-title {
      font-size: min(5.2vw, 10svh);
    }
    :global(:lang(ar)) .hero-title {
      font-size: min(4.6vw, 9svh);
    }
    .hero-avail {
      display: none;
    }
  }
</style>
