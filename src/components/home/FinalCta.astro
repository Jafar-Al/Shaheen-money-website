---
// In the browser: src/scripts/home/close.ts (loaded once by the homepage).
import Chapter from '../ui/Chapter.astro';
import Emph from '../ui/Emph.astro';
import TextLink from '../ui/TextLink.astro';
import DownloadButton from '../site/DownloadButton.astro';
import StoreBadges from '../site/StoreBadges.astro';
import Device from '../app/Device.astro';
import FalconFold from './FalconFold.astro';
import FeatherField from '../art/FeatherField.astro';
import { home } from '../../copy/home';
import { common } from '../../copy/common';
import { href, type Locale } from '../../i18n/config';

/**
 * 08 — Download: the close, and the bookend to the first screen. The page
 * returns to Night, the falcon comes back and folds into its resting mark,
 * and the app is shown whole for the first and only time, in a matte device.
 * The same single download button as the hero, then talking to us and
 * becoming a Connector. id="download" keeps old /#download links working.
 */
interface Props {
  locale: Locale;
  n: number;
}
const { locale, n } = Astro.props;
const t = home[locale].final;
---

<section id="download" class="close t-night grain cv-auto" data-temp="night" aria-labelledby="final-title" data-close>
  <div class="close-field" aria-hidden="true">
    <FeatherField seed="download" variant="strip" follow />
  </div>
  <div class="page rhythm-airy close-grid">
    <div class="close-copy">
      <FalconFold />
      <Chapter n={n} label={common[locale].nav.getApp} />
      <h2 id="final-title" class="text-display-xl font-display close-title"><Emph text={t.title} /></h2>
      <p class="lead">{t.lead}</p>
      <div class="close-actions">
        <DownloadButton locale={locale} />
        <StoreBadges locale={locale} />
      </div>
      <div class="close-links">
        <TextLink href={href(locale, 'contact')}>{t.coverage}</TextLink>
        <TextLink href={href(locale, 'business')}>{t.connector}</TextLink>
      </div>
    </div>
    <Device locale={locale} class="close-device" />
  </div>
</section>

<style>
  .close {
    position: relative;
    overflow: clip;
    background-color: var(--bg);
    color: var(--fg);
  }
  .close-field {
    position: absolute;
    inset: auto 0 0;
    block-size: 60%;
    opacity: 0.5;
    color: var(--fg);
    pointer-events: none;
  }
  .close-grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 4rem;
    align-items: center;
  }
  .close-copy {
    grid-column: 1 / span 7;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }
  .close-title {
    font-size: min(8vw, 8rem);
    line-height: var(--lh-display-xl);
  }
  :global(:lang(ar)) .close-title {
    font-size: min(7vw, 7rem);
  }
  .close-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .close-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
  }
  .close-grid :global(.close-device) {
    grid-column: 8 / -1;
  }
  @media (width < 64rem) {
    .close-copy,
    .close-grid :global(.close-device) {
      grid-column: 1 / -1;
    }
    .close-title {
      font-size: 13vw;
    }
    :global(:lang(ar)) .close-title {
      font-size: 11vw;
    }
  }
</style>
