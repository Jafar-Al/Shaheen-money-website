---
/**
 * The app's own glyphs, redrawn from the owner's screenshots: thin navy
 * strokes inside white discs (actions), cyan on blue (menu and QR). These
 * belong to the product, not to the site's glyph set, so they keep the
 * app's round caps.
 */
interface Props {
  name: 'add' | 'withdraw' | 'send' | 'request' | 'swap' | 'menu' | 'qr' | 'in' | 'out' | 'cash';
  class?: string;
}
const { name, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  add: '<path d="M12 19V5M6.5 10.5 12 5l5.5 5.5"/>',
  withdraw: '<path d="M12 5v14M6.5 13.5 12 19l5.5-5.5"/>',
  send: '<rect x="3.5" y="6.5" width="12" height="12" rx="2"/><path d="M9.5 9.2v6.6M11.3 10.3c-.4-.6-1-.9-1.8-.9-1 0-1.8.6-1.8 1.4 0 1.9 3.7 1.1 3.7 3 0 .8-.8 1.4-1.9 1.4-.8 0-1.5-.3-1.9-.9M18.5 10.5V3.5M16 6l2.5-2.5L21 6"/>',
  request: '<rect x="8.5" y="5.5" width="12" height="12" rx="2"/><path d="M14.5 8.2v6.6M16.3 9.3c-.4-.6-1-.9-1.8-.9-1 0-1.8.6-1.8 1.4 0 1.9 3.7 1.1 3.7 3 0 .8-.8 1.4-1.9 1.4-.8 0-1.5-.3-1.9-.9M5.5 13.5v7M3 18l2.5 2.5L8 18"/>',
  swap: '<path d="M19 8.5H5M8.5 5 5 8.5 8.5 12M5 15.5h14M15.5 12l3.5 3.5-3.5 3.5"/>',
  menu: '<path d="M4 6.5h16M4 12h11M4 17.5h7"/>',
  qr: '<path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM6.5 6.5h1v1h-1zM16.5 6.5h1v1h-1zM6.5 16.5h1v1h-1zM14 14h2.5v2.5H14zM17.5 17.5H20V20h-2.5zM14 19h2M19 14v2"/>',
  in: '<path d="M12 4.5v15M6.5 14 12 19.5 17.5 14"/>',
  out: '<path d="M12 19.5v-15M6.5 10 12 4.5 17.5 10"/>',
  cash: '<rect x="3" y="7" width="18" height="10" rx="1.5"/><path d="M12 9.5v5M13.5 10.3c-.3-.4-.8-.6-1.4-.6-.8 0-1.4.4-1.4 1 0 1.4 2.9.8 2.9 2.2 0 .6-.6 1.1-1.5 1.1-.6 0-1.2-.2-1.5-.7"/>',
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={paths[name]}
/>
