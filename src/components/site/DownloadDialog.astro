---
import QRCode from 'qrcode';
import StoreBadges from './StoreBadges.astro';
import Icon from '../ui/Icon.astro';
import { common } from '../../copy/common';
import { DOWNLOAD_URL } from '../../config/download';
import type { Locale } from '../../i18n/config';

/**
 * Shown when the download button is pressed on a computer: scan the code with
 * a phone and the edge redirect sends it to the right store. Native <dialog>:
 * focus is trapped and restored by the browser, Esc closes it.
 * Error correction H leaves room for the falcon in the middle.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = common[locale].download;

const qr = (
  await QRCode.toString(DOWNLOAD_URL, {
    type: 'svg',
    errorCorrectionLevel: 'H',
    margin: 0,
    color: { dark: '#071138ff', light: '#ffffff00' },
  })
).replace('<svg ', '<svg aria-hidden="true" focusable="false" width="100%" height="100%" ');
---

<dialog id="download-dialog" class="download-dialog" aria-labelledby="download-dialog-title">
  <div class="flex flex-col items-center gap-5 text-center">
    <button
      type="button"
      data-dialog-close
      class="grid size-11 place-items-center self-end rounded-full text-fg-2 hover:bg-muted hover:text-fg"
    >
      <Icon name="close" size={20} label={t.close} />
    </button>
    <h2 id="download-dialog-title" class="-mt-8 text-h2 font-display">{t.dialogTitle}</h2>
    <p class="text-body text-fg-2">{t.dialogBody}</p>
    <div class="relative size-56 rounded-md bg-white p-3 shadow-sm ring-1 ring-line">
      <div class="size-full" set:html={qr} />
      <span class="absolute inset-0 grid place-items-center" aria-hidden="true">
        <span class="grid size-12 place-items-center rounded-full bg-navy text-white ring-4 ring-white">
          <svg viewBox="0 0 240 240" width="26" height="26" focusable="false"><use href="#falcon-mark"></use></svg>
        </span>
      </span>
    </div>
    <p class="text-caption text-fg-2">{t.or}</p>
    <StoreBadges locale={locale} class="justify-center" />
  </div>
</dialog>
