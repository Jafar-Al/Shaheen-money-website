---
import QRCode from 'qrcode';
import StoreBadges from './StoreBadges.astro';
import Icon from '../ui/Icon.astro';
import { common } from '../../copy/common';
import { DOWNLOAD_URL } from '../../config/download';
import type { Locale } from '../../i18n/config';

/**
 * Shown when the download button is pressed on a computer: scan the code with
 * a phone and the edge redirect sends it to the right store. Native <dialog>:
 * focus is trapped and restored by the browser, Esc closes it.
 * Error correction H leaves room for the falcon in the middle.
 *
 * A sheet of Paper over the page, whatever the page's temperature.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = common[locale].download;

const qr = (
  await QRCode.toString(DOWNLOAD_URL, {
    type: 'svg',
    errorCorrectionLevel: 'H',
    margin: 0,
    color: { dark: '#071138ff', light: '#ffffff00' },
  })
).replace('<svg ', '<svg aria-hidden="true" focusable="false" width="100%" height="100%" ');
---

<dialog id="download-dialog" class="download-dialog t-paper" aria-labelledby="download-dialog-title">
  <div class="dd">
    <button type="button" data-dialog-close class="dd-close">
      <Icon name="close" size={18} label={t.close} />
    </button>
    <h2 id="download-dialog-title" class="dd-title font-display">{t.dialogTitle}</h2>
    <p class="dd-body">{t.dialogBody}</p>
    <div class="dd-qr">
      <div class="dd-qr-code" set:html={qr} />
      <span class="dd-qr-mark" aria-hidden="true">
        <svg viewBox="0 0 240 240" width="26" height="26" focusable="false"><use href="#falcon-mark"></use></svg>
      </span>
    </div>
    <p class="micro dd-or">{t.or}</p>
    <StoreBadges locale={locale} class="dd-badges" />
  </div>
</dialog>

<style>
  .dd {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    text-align: center;
  }
  .dd-close {
    display: grid;
    place-items: center;
    align-self: flex-end;
    inline-size: var(--target-min);
    block-size: var(--target-min);
    margin-block-end: -2.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-full);
    color: var(--fg-2);
    transition:
      color var(--motion-hover) var(--ease-hover),
      border-color var(--motion-hover) var(--ease-hover);
  }
  .dd-close:hover {
    border-color: var(--line-strong);
    color: var(--fg);
  }
  .dd-title {
    max-inline-size: 16ch;
    font-size: var(--text-h3);
    line-height: var(--lh-h3);
  }
  .dd-body {
    color: var(--fg-2);
  }
  .dd-qr {
    position: relative;
    inline-size: 14rem;
    aspect-ratio: 1;
    padding: 0.75rem;
    border: 1px solid var(--line);
    background-color: #fff;
  }
  .dd-qr-code {
    inline-size: 100%;
    block-size: 100%;
  }
  .dd-qr-mark {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }
  .dd-qr-mark svg {
    inline-size: 3rem;
    block-size: 3rem;
    padding: 0.6rem;
    border: 4px solid #fff;
    border-radius: var(--radius-full);
    background-color: var(--color-navy-800);
    color: #fff;
  }
  .dd-or {
    color: var(--fg-2);
  }
  .dd :global(.dd-badges) {
    justify-content: center;
  }
</style>
