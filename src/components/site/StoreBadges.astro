---
import BrandIcon from '../ui/BrandIcon.astro';
import { stores } from '../../config/site';
import { common } from '../../copy/common';
import type { Locale } from '../../i18n/config';

/**
 * Both store links as one grouped unit (audit P-10). Hrefs come only from
 * src/config/site.ts; scripts/check-dist.mjs verifies every rendered store
 * link against that allow-list (threat model A6).
 */
interface Props {
  locale: Locale;
  tone?: 'light' | 'dark';
  class?: string;
}

const { locale, tone = 'light', class: className } = Astro.props;
const t = common[locale].stores;

const badge = [
  'inline-flex min-h-14 items-center gap-3 rounded-md px-5 transition duration-150',
  tone === 'dark'
    ? 'bg-white text-navy hover:bg-muted'
    : 'bg-navy text-fg-inverse hover:bg-navy-800',
];
---

<div role="group" aria-label={t.group} class:list={['flex flex-wrap gap-3', className]}>
  <a href={stores.ios} class:list={badge} data-store="ios" data-btn="store">
    <BrandIcon name="apple" size={24} />
    <span class="flex flex-col items-start">
      <span class="text-caption">{t.ios.kicker}</span>
      <span class="text-button" lang="en">{t.ios.name}</span>
    </span>
  </a>
  <a href={stores.android} class:list={badge} data-store="android" data-btn="store">
    <BrandIcon name="googleplay" size={22} />
    <span class="flex flex-col items-start">
      <span class="text-caption">{t.android.kicker}</span>
      <span class="text-button" lang="en">{t.android.name}</span>
    </span>
  </a>
</div>
