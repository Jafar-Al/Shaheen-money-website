---
import BrandIcon from '../ui/BrandIcon.astro';
import { socials } from '../../config/site';
import { common } from '../../copy/common';
import type { Locale } from '../../i18n/config';

/** 44×44 targets with 8px separation (audit P-11). */
interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className } = Astro.props;
const t = common[locale];
---

<ul class:list={['flex flex-wrap gap-2', className]} aria-label={t.footer.social}>
  {
    socials.map((s) => (
      <li>
        <a
          href={s.href}
          target="_blank"
          rel="noopener noreferrer"
          class="grid size-11 place-items-center rounded-full text-fg-2 transition duration-150 hover:bg-muted hover:text-fg"
        >
          <BrandIcon name={s.network} size={20} />
          <span class="sr-only">
            {s.label} {t.ui.opensNewTab}
          </span>
        </a>
      </li>
    ))
  }
</ul>
