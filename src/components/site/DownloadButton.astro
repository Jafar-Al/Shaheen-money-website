---
import Icon from '../ui/Icon.astro';
import { common } from '../../copy/common';
import { downloadPath } from '../../config/download';
import { href, type Locale } from '../../i18n/config';

/**
 * The one download button. One label, one glyph, on every device: it never
 * says iPhone or Android, because it does not have to. It works out the
 * visitor's device by itself and goes straight to the right store, with no
 * choice and no pop-up:
 *   iPhone/iPad → App Store, Android → Google Play,
 *   computer    → the "Get the app" page, which shows both stores (a
 *                 computer is not the phone the app is for, so it cannot
 *                 know which store to open).
 * The device is read from html[data-platform], decided before first paint by
 * the inline script in BaseLayout.astro; src/scripts/smart-download.ts then
 * points the link at the store. Without JavaScript the link still works:
 * /download redirects on the server by user agent (scripts/postbuild.mjs).
 *
 * Drawn as the system's pill (global .btn), the download arrow in the circle
 * where other buttons carry theirs.
 */
interface Props {
  locale: Locale;
  variant?: 'solid' | 'line';
  /** Full width on a phone. */
  block?: boolean;
  class?: string;
}

const { locale, variant = 'solid', block = false, class: className } = Astro.props;
const t = common[locale].download;
---

<a
  href={downloadPath(locale)}
  data-smart-download
  data-fallback={href(locale, 'getApp')}
  data-btn={variant}
  data-magnetic
  class:list={['btn', `btn-${variant}`, 'dl-button', block && 'btn-block', className]}
>
  <span class="btn-label">{t.label}</span>
  <span class="btn-mark" aria-hidden="true">
    <Icon name="download" size={18} class="btn-arrow btn-arrow-down" />
  </span>
</a>
