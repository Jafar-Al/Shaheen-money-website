---
import BrandIcon from '../ui/BrandIcon.astro';
import Icon from '../ui/Icon.astro';
import { common } from '../../copy/common';
import { downloadPath } from '../../config/download';
import type { Locale } from '../../i18n/config';

/**
 * The one download button. It works out the visitor's device by itself:
 *   iPhone/iPad → App Store, Android → Google Play (label and glyph adapt),
 *   computer    → opens a QR code to scan with the phone.
 * Without JavaScript the link still works: /download redirects on the server
 * by user agent (scripts/postbuild.mjs). Label and glyph switch with CSS on
 * html[data-platform], decided before first paint, so nothing shifts.
 *
 * Drawn as the system's pill (global .btn): the platform glyph sits in the
 * circle where other buttons carry their arrow.
 */
interface Props {
  locale: Locale;
  variant?: 'solid' | 'line';
  /** Full width on a phone. */
  block?: boolean;
  class?: string;
}

const { locale, variant = 'solid', block = false, class: className } = Astro.props;
const t = common[locale].download;
---

<a
  href={downloadPath(locale)}
  data-smart-download
  data-btn={variant}
  data-magnetic
  class:list={['btn', `btn-${variant}`, 'dl-button', block && 'btn-block', className]}
>
  <span class="btn-label">
    <span class="dl-when-desktop">{t.label}</span>
    <span class="dl-when-ios">{t.ios}</span>
    <span class="dl-when-android">{t.android}</span>
  </span>
  <span class="btn-mark" aria-hidden="true">
    <span class="dl-when-desktop"><Icon name="download" size={18} class="btn-arrow btn-arrow-down" /></span>
    <span class="dl-when-ios"><BrandIcon name="apple" size={17} /></span>
    <span class="dl-when-android"><BrandIcon name="googleplay" size={15} /></span>
  </span>
</a>
