---
import Icon from '../ui/Icon.astro';
import Gap from '../ui/Gap.astro';
import { common } from '../../copy/common';
import { facts } from '../../data/facts';
import { formatNumber } from '../../lib/format';
import { href, type Locale } from '../../i18n/config';

/**
 * The announcement strip: answers "is this safe?" before it is asked, in
 * one mono line over a hairline. Built only from facts that exist (audit
 * P-02); with none it is not rendered. On a phone it keeps the first
 * statement and the link.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = common[locale];

const items: string[] = [];
if (facts.safeguarding) items.push(t.trust.selfCustody);
for (const l of facts.licences) items.push(`${t.trust.licensed}: ${l.regulator[locale]} · ${l.jurisdiction[locale]}`);
const ratings = [
  facts.ratings.ios && `${formatNumber(facts.ratings.ios.value.score, locale, 1)} App Store`,
  facts.ratings.android && `${formatNumber(facts.ratings.android.value.score, locale, 1)} Google Play`,
].filter(Boolean);
if (ratings.length) items.push(ratings.join(' · '));
/** "Self-custodial — we never hold your money": a phone keeps the first phrase. */
const parts = (item: string) => {
  const m = item.match(/^(.+?)(\s[—–]\s|،\s)(.+)$/);
  return m ? { head: m[1]!, sep: m[2]!, tail: m[3]! } : { head: item, sep: '', tail: '' };
};
---

{
  items.length > 0 && (
    <aside aria-label={t.trust.label} class="strip t-night" data-site-strip data-temp="night">
      <div class="page strip-row label">
        <ul class="strip-items">
          {items.map((item, i) => {
            const { head, sep, tail } = parts(item);
            return (
              <li class:list={['strip-item', i > 0 && 'strip-more']}>
                <span>
                  {head}
                  {tail && (
                    <span class="strip-tail">
                      {sep}
                      {tail}
                    </span>
                  )}
                </span>
              </li>
            );
          })}
        </ul>
        <a href={href(locale, 'security')} class="strip-link">
          {t.trust.protect}
          <Icon name="arrow-right" size={14} directional />
        </a>
      </div>
    </aside>
  )
}
{items.length === 0 && <Gap need="Licence + regulator and real store ratings for the announcement strip. Nothing unverifiable goes here." />}

<style>
  .strip {
    position: relative;
    z-index: 51;
    background-color: var(--color-night-950);
    border-block-end: 1px solid var(--line);
    color: var(--fg-2);
  }
  .strip-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-block-size: var(--strip-h);
  }
  .strip-items {
    display: flex;
    gap: 2rem;
    overflow: hidden;
    white-space: nowrap;
  }
  .strip-item {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .strip-item::before {
    content: '';
    inline-size: 5px;
    block-size: 5px;
    border-radius: var(--radius-full);
    background-color: var(--accent);
  }
  /* A phone shows the first phrase only; the rest is still read out. */
  .strip-more,
  .strip-tail {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @media (width >= 48rem) {
    .strip-more,
    .strip-tail {
      position: static;
      inline-size: auto;
      block-size: auto;
      overflow: visible;
      clip-path: none;
    }
  }
  @media (width < 30rem) {
    .strip-row {
      gap: 0.75rem;
      font-size: 0.6875rem;
      letter-spacing: 0.04em;
    }
    .strip-item::before {
      display: none;
    }
  }
  .strip-link {
    display: inline-flex;
    flex: none;
    white-space: nowrap;
    align-items: center;
    gap: 0.375rem;
    min-block-size: var(--strip-h);
    color: var(--fg);
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--line-strong);
  }
  .strip-link:hover {
    text-decoration-color: currentColor;
  }
</style>
