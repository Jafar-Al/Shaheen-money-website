---
import JsonLd from '../seo/JsonLd.astro';
import { common } from '../../copy/common';
import { absoluteUrl, href, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  /** Trail after Home; the last item is the current page. */
  items: Array<{ label: string; href?: string }>;
}

const { locale, items } = Astro.props;
const t = common[locale].ui;
const trail = [{ label: t.home, href: href(locale, 'home') }, ...items];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: absoluteUrl(item.href) } : {}),
  })),
};
---

<nav aria-label={t.breadcrumbs} class="crumbs">
  <ol class="label">
    {
      trail.map((item, i) => (
        <li>
          {i > 0 && (
            <span class="crumb-sep" aria-hidden="true">
              /
            </span>
          )}
          {item.href && i < trail.length - 1 ? (
            <a href={item.href} class="crumb-link">
              {item.label}
            </a>
          ) : (
            <span aria-current="page" class="crumb-here">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<JsonLd data={jsonLd} />

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.625rem;
    color: var(--fg-2);
  }
  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
  }
  .crumb-sep {
    color: var(--fg-3);
  }
  .crumb-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 1.5rem;
    color: inherit;
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
    text-decoration-color: var(--line-strong);
  }
  .crumb-link:hover {
    color: var(--fg);
    text-decoration-color: currentColor;
  }
  .crumb-here {
    color: var(--fg);
  }
</style>
