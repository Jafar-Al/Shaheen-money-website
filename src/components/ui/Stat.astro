---
import SourceNote from './SourceNote.astro';
import type { Locale } from '../../i18n/config';
import type { Sourced } from '../../data/types';

/**
 * A figure with its source. The `stat` prop is `Sourced<number>`, so a
 * number cannot be rendered here without a source and an as-of date
 * (audit O.4 "Stats": the component must make it impossible).
 */
interface Props {
  stat: Sourced<number>;
  /** The formatted figure, e.g. "6.36%". */
  display: string;
  label: string;
  locale: Locale;
  tone?: 'light' | 'dark';
  class?: string;
}

const { stat, display, label, locale, tone = 'light', class: className } = Astro.props;
---

<div class:list={['flex flex-col gap-3', className]}>
  <p class="flex flex-col gap-2">
    <span class:list={['num text-display-lg font-display', tone === 'dark' ? 'text-fg-inverse' : 'text-fg']}>
      {display}
    </span>
    <span class:list={['text-body-lg measure', tone === 'dark' ? 'text-fg-inverse-2' : 'text-fg-2']}>{label}</span>
  </p>
  <SourceNote source={stat.source} locale={locale} tone={tone} />
</div>
