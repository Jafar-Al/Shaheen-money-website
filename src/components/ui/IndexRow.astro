---
/**
 * One row of an editorial index: number · title in the display face ·
 * description · meta at the end. As a link, the whole row is one focus
 * target and, on a precise pointer, it shifts 8px in the reading direction
 * on hover. Used for "Who it's for", the blog index and leadership.
 *
 * `plate` slots an image or generated cover that slides in beside the row
 * on hover (hover-capable pointers only; touch devices get the rows).
 */
interface Props {
  n?: number;
  title: string;
  text?: string;
  meta?: string;
  href?: string;
  headingLevel?: 'h2' | 'h3' | 'h4' | 'span';
  size?: 'md' | 'lg';
  titleLang?: string;
  class?: string;
}
const { n, title, text, meta, href, headingLevel = 'h3', size = 'md', titleLang, class: className } = Astro.props;
const Heading = headingLevel;
const Tag = href ? 'a' : 'div';
const hasPlate = Astro.slots.has('plate');
---

<Tag href={href} class:list={['index-row', `index-row-${size}`, href && 'index-row-link', className]}>
  {n !== undefined && <span class="index-n num" aria-hidden="true">{String(n).padStart(2, '0')}</span>}
  <span class="index-main">
    <Heading class="index-title" lang={titleLang}>{title}</Heading>
    {text && <span class="index-text">{text}</span>}
  </span>
  {meta && <span class="index-meta micro">{meta}</span>}
  {
    hasPlate && (
      <span class="index-plate" aria-hidden="true" data-art>
        <slot name="plate" />
      </span>
    )
  }
</Tag>

<style>
  .index-row {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.5rem 1.25rem;
    align-items: baseline;
    padding-block: 1.5rem;
    border-block-end: 1px solid var(--line);
    color: var(--fg);
  }
  @media (width >= 48rem) {
    .index-row {
      grid-template-columns: 3.5rem minmax(0, 1fr) minmax(8rem, auto);
    }
  }
  .index-n {
    font-size: var(--text-label);
    color: var(--accent);
  }
  .index-main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transition: translate var(--motion-standard) var(--ease-out);
  }
  .index-title {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
  }
  .index-row-lg .index-title {
    font-size: var(--text-display-m);
    line-height: var(--lh-display-m);
  }
  .index-text {
    max-inline-size: var(--measure);
    font-size: var(--text-body);
    line-height: var(--lh-body);
    color: var(--fg-2);
  }
  .index-meta {
    grid-column: 2;
    color: var(--fg-2);
  }
  @media (width >= 48rem) {
    .index-meta {
      grid-column: 3;
      text-align: end;
    }
  }

  .index-plate {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) and (width >= 64rem) {
    .index-plate {
      position: absolute;
      inset-block-start: 50%;
      inset-inline-end: 14rem;
      z-index: 2;
      display: block;
      inline-size: 16rem;
      aspect-ratio: 4 / 3;
      opacity: 0;
      translate: 0 -46%;
      scale: 0.96;
      pointer-events: none;
      transition:
        opacity var(--motion-hover) var(--ease-hover),
        translate var(--motion-standard) var(--ease-out),
        scale var(--motion-standard) var(--ease-out);
    }
    .index-row-link:hover .index-plate {
      opacity: 1;
      translate: 0 -50%;
      scale: 1;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .index-row-link:hover .index-main {
      translate: calc(8px * var(--dir)) 0;
    }
    .index-row-link:hover .index-title {
      text-decoration-line: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.18em;
    }
  }
</style>
