---
/** A numbered marker next to a figure, linking to its source line below. */
interface Props {
  n: number;
  idPrefix?: string;
  label: string;
}
const { n, idPrefix = 'source', label } = Astro.props;
---

<a href={`#${idPrefix}-${n}`} class="fnref num" aria-label={`${label} ${n}`}>{n}</a>

<style>
  .fnref {
    display: inline-grid;
    place-items: center;
    min-inline-size: 1.375rem;
    block-size: 1.375rem;
    margin-inline-start: 0.35em;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-full);
    font-size: 0.6875rem;
    line-height: 1;
    letter-spacing: 0;
    color: var(--accent);
    vertical-align: super;
    transition: border-color var(--motion-hover) var(--ease-hover);
  }
  .fnref:hover {
    border-color: var(--accent);
  }
</style>
