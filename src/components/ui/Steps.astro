---
import { formatNumber } from '../../lib/format';
import type { Locale } from '../../i18n/config';

/** Numbered steps with top rules; the emphasised one carries the navy rule. */
interface Props {
  items: Array<{ title: string; body: string }>;
  locale: Locale;
  columns?: 1 | 2 | 3 | 4;
  emphasize?: number;
  headingLevel?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const { items, locale, columns = 4, emphasize, headingLevel = 'h3', class: className } = Astro.props;
const Heading = headingLevel;
const cols = { 1: 'grid-cols-1', 2: 'sm:grid-cols-2 lg:grid-cols-2', 3: 'sm:grid-cols-2 lg:grid-cols-3', 4: 'sm:grid-cols-2 lg:grid-cols-4' }[columns];
// Optional extra content under a step, passed as slot="after-<index>".
const extras = await Promise.all(
  items.map((_, i) => (Astro.slots.has(`after-${i}`) ? Astro.slots.render(`after-${i}`) : Promise.resolve(''))),
);
---

<ol class:list={['grid gap-x-8 gap-y-10', cols, className]}>
  {
    items.map((item, i) => (
      <li class:list={['flex flex-col gap-3 border-t-2 pt-6', i === emphasize ? 'border-navy' : 'border-line']}>
        <span class="num text-body-sm font-semibold text-navy">{formatNumber(i + 1, locale).padStart(2, '0')}</span>
        <Heading class="text-h3 font-display">{item.title}</Heading>
        <p class="text-body text-fg-2">{item.body}</p>
        {extras[i] && <Fragment set:html={extras[i]} />}
      </li>
    ))
  }
</ol>
