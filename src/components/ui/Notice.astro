---
import Icon from './Icon.astro';
import type { IconName } from './icons';

/** Icon + colour + text — colour is never the only signal (audit O.4 "Alerts"). */
interface Props {
  kind?: 'info' | 'success' | 'warning' | 'error';
  title?: string;
  /** role="alert" for errors that need announcing; role="status" otherwise. */
  live?: boolean;
  class?: string;
}

const { kind = 'info', title, live = false, class: className } = Astro.props;

const styles: Record<NonNullable<Props['kind']>, { box: string; icon: IconName }> = {
  info: { box: 'bg-info-bg text-fg', icon: 'info' },
  success: { box: 'bg-success-bg text-fg', icon: 'check' },
  warning: { box: 'bg-warning-bg text-fg', icon: 'alert' },
  error: { box: 'bg-error-bg text-fg', icon: 'alert' },
};
const iconColor = { info: 'text-blue', success: 'text-success', warning: 'text-warning', error: 'text-error' }[kind];
const { box, icon } = styles[kind];
---

<div
  class:list={['flex gap-3 rounded-md p-4', box, className]}
  role={live ? (kind === 'error' ? 'alert' : 'status') : undefined}
>
  <Icon name={icon} size={20} class:list={['mt-0.5', iconColor]} />
  <div class="flex flex-col gap-1 text-body-sm">
    {title && <p class="font-semibold">{title}</p>}
    <slot />
  </div>
</div>
