---
/**
 * A neighbourhood shop, engraved: striped and scalloped awning, a roller
 * shutter half up, shelves, and the counter where cash changes hands, with
 * the falcon on a hanging sign. Hairlines and hatching only (the language
 * of the whole site), drawn in code so it is sharp at any size and weighs a
 * few kilobytes. It draws itself in, line by line, when it is revealed.
 *
 * No words inside the drawing: it reads the same in both languages, and it
 * is decorative (aria-hidden, dropped in forced colours).
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const W = 600;
const r = (n: number) => Math.round(n * 10) / 10;

// Awning: a scalloped front edge and alternate hatched stripes.
const awningTop = 92;
const awningEdge = 150;
const scallops: string[] = [];
for (let x = 40; x < 560; x += 40) scallops.push(`M${x} ${awningEdge}a20 20 0 0 0 40 0`);
const stripes: Array<{ x: number; hatched: boolean }> = [];
for (let x = 40, i = 0; x < 560; x += 40, i++) stripes.push({ x, hatched: i % 2 === 0 });

// Roller shutter, half up.
const slats: string[] = [];
for (let y = 172; y <= 226; y += 6) slats.push(`M104 ${y}H496`);

// Shelves and what is on them.
const shelves = [252, 292];
const goods: string[] = [];
const place = [128, 152, 170, 206, 232, 268, 300, 326, 360, 392, 418, 446];
place.forEach((x, i) => {
  const h = 14 + ((i * 7) % 12);
  const w = 10 + ((i * 5) % 9);
  const base = i % 2 === 0 ? shelves[0]! : shelves[1]!;
  goods.push(i % 3 === 0 ? `M${x} ${base}v-${h}a${w / 2} ${w / 4} 0 0 1 ${w} 0v${h}` : `M${x} ${base}v-${h}h${w}v${h}`);
});

// Counter-front hatching (engraved shading), clipped to the counter.
const hatch: string[] = [];
for (let x = 120; x < 480; x += 7) hatch.push(`M${x} 420L${x + 40} 330`);

// Brick coursing on the facade, either side of the opening.
const bricks: string[] = [];
for (let y = 168, row = 0; y < 420; y += 14, row++) {
  bricks.push(`M62 ${y}H98M502 ${y}H538`);
  const off = row % 2 ? 0 : 9;
  for (let x = 62 + off; x < 98; x += 18) bricks.push(`M${x} ${y}v14`);
  for (let x = 502 + off; x < 538; x += 18) bricks.push(`M${x} ${y}v14`);
}
---

<svg class:list={['shop', className]} viewBox={`0 0 ${W} 440`} aria-hidden="true" focusable="false" data-art data-reveal>
  <defs>
    <clipPath id="shop-counter-clip">
      <rect x="140" y="330" width="320" height="90"></rect>
    </clipPath>
    <clipPath id="shop-stripe-clip">
      {stripes.filter((s) => s.hatched).map((s) => <rect x={s.x} y={awningTop} width="40" height={awningEdge - awningTop + 20} />)}
    </clipPath>
  </defs>

  <!-- ground and facade -->
  <path class="shop-line shop-strong" d="M16 420H584" pathLength="1" data-draw></path>
  <path class="shop-line" d="M60 420V64H540V420" pathLength="1" data-draw></path>
  <path class="shop-fine" d={bricks.join('')}></path>

  <!-- sign board above the awning -->
  <path class="shop-line" d="M176 26H424V58H176Z" pathLength="1" data-draw></path>
  <path class="shop-fine" d="M186 36H414M186 48H414"></path>

  <!-- awning -->
  <path class="shop-line" d={`M40 ${awningTop}H560V${awningEdge}M40 ${awningTop}V${awningEdge}`} pathLength="1" data-draw></path>
  <path class="shop-line" d={scallops.join('')}></path>
  <path class="shop-fine" d={stripes.map((s) => `M${s.x} ${awningTop}V${awningEdge}`).join('')}></path>
  <g clip-path="url(#shop-stripe-clip)">
    <path
      class="shop-fine"
      d={Array.from({ length: 90 }, (_, i) => `M${40 + i * 6} ${awningTop}l-20 ${awningEdge - awningTop + 20}`).join('')}
    ></path>
  </g>

  <!-- opening, shutter, shelves -->
  <path class="shop-line" d="M100 420V168H500V420" pathLength="1" data-draw></path>
  <path class="shop-fine" d={slats.join('')}></path>
  <path class="shop-line" d="M100 230H500"></path>
  <path class="shop-fine" d={`M120 ${shelves[0]}H480M120 ${shelves[1]}H480`}></path>
  <path class="shop-fine" d={goods.join('')}></path>

  <!-- the counter -->
  <path class="shop-line shop-strong" d="M128 322H472V330H128Z" pathLength="1" data-draw></path>
  <path class="shop-line" d="M140 330V420M460 330V420"></path>
  <g clip-path="url(#shop-counter-clip)"><path class="shop-fine" d={hatch.join('')}></path></g>

  <!-- cash on the counter: the one warm thing in the drawing -->
  <g class="shop-cash">
    <path d="M208 322l6 -14h64l-6 14Z"></path>
    <path d="M214 316l6 -14h64l-6 14Z"></path>
    <path d="M220 310l6 -14h64l-6 14Z"></path>
  </g>

  <!-- hanging sign with the falcon -->
  <path class="shop-line" d="M540 176H572M556 176V190"></path>
  <circle class="shop-line" cx="556" cy="214" r="24"></circle>
  <svg x="541" y="199" width="30" height="30" viewBox="0 0 240 240" class="shop-mark">
    <use href="#falcon-mark"></use>
  </svg>
</svg>

<style>
  .shop {
    display: block;
    inline-size: 100%;
    block-size: auto;
    color: var(--fg);
    overflow: visible;
  }
  .shop path,
  .shop circle {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .shop-line {
    stroke: currentColor;
    stroke-width: 1.1;
    stroke-opacity: 0.85;
  }
  .shop-strong {
    stroke-width: 1.6;
  }
  .shop-fine {
    stroke: currentColor;
    stroke-width: 0.6;
    stroke-opacity: 0.45;
  }
  .shop-cash path {
    fill: color-mix(in srgb, var(--cash) 18%, transparent);
    stroke: var(--cash);
    stroke-width: 1.1;
  }
  .shop-mark {
    color: currentColor;
  }
  .shop-mark :global(use) {
    fill: currentColor;
  }
</style>
