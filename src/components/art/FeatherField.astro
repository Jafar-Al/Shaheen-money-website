---
import { feather, fieldSpecs, type FieldVariant, type Pt } from '../../lib/feather';

/**
 * A feather field: engraved hairline feathers, generated at build time from
 * a seed (src/lib/feather.ts). The recurring texture of the site, derived
 * from the falcon's own feathers: a strip across the top of every inner
 * page, a cover for every blog post, a cropped plume in the footer.
 *
 * One barb in each feather is drawn in the accent colour: the "active
 * feather", the route. It strokes itself in when the field is revealed.
 *
 * `trail` (the 404) continues the accent barb as a dashed route that arcs
 * away and stops at an open ring: a route with no city at the end of it.
 *
 * Decorative: aria-hidden, dropped in forced-colours mode ([data-art]).
 */
interface Props {
  seed: string;
  variant: FieldVariant;
  /** Point the plume in the reading direction (mirrors in Arabic). */
  follow?: boolean;
  /** Continue the accent barb as a dashed route to nowhere. */
  trail?: boolean;
  class?: string;
}
const { seed, variant, follow = false, trail = false, class: className } = Astro.props;
const { viewBox, specs } = fieldSpecs(variant, seed);
const feathers = specs.map(feather);

// The route to nowhere: leave the accent tip the way the barb is heading,
// then turn (about 75°, toward the open side) and stop in open space.
const tip = trail ? feathers[0]?.accentTip : null;
const route = tip
  ? (() => {
      const [x, y] = tip.at;
      const [dx, dy] = tip.dir;
      const bend = -1.3;
      const [ex, ey]: Pt = [Math.cos(bend) * dx - Math.sin(bend) * dy, Math.sin(bend) * dx + Math.cos(bend) * dy];
      const along = ([px, py]: Pt, [ux, uy]: Pt, k: number): Pt => [px + ux * k, py + uy * k];
      const from = along([x, y], [dx, dy], 10);
      const ctrl = along(from, [dx, dy], 80);
      const to = along(ctrl, [ex, ey], 170);
      // The dashes stop at the ring's edge; the reveal runs on past the
      // ring, so butt caps still uncover all of it.
      const edge = along(to, [ex, ey], -7);
      const past = along(to, [ex, ey], 16);
      const f = ([px, py]: Pt) => `${Math.round(px * 10) / 10} ${Math.round(py * 10) / 10}`;
      const curve = `M${f(from)}Q${f(ctrl)}`;
      return { d: `${curve} ${f(edge)}`, reveal: `${curve} ${f(to)}L${f(past)}`, end: to };
    })()
  : null;
const maskId = `ff-trail-${seed.replace(/[^a-z0-9-]/gi, '')}`;
---

<svg
  class:list={['feather-field', `feather-${variant}`, follow && 'feather-follow', className]}
  viewBox={viewBox}
  preserveAspectRatio={variant === 'corner' ? 'xMaxYMax slice' : variant === 'single' ? 'xMaxYMid slice' : 'xMidYMid slice'}
  aria-hidden="true"
  focusable="false"
  data-art
  data-reveal
>
  {
    feathers.map((f) => (
      <g>
        <path class="ff-barbs" d={f.barbs} />
        <path class="ff-rachis" d={f.rachis} />
        {f.accent && <path class="ff-accent" d={f.accent} pathLength="1" data-draw />}
      </g>
    ))
  }
  {
    route && (
      <g class="ff-trail">
        <mask id={maskId} maskUnits="userSpaceOnUse" x="-200" y="-200" width="1000" height="1000">
          <path class="ff-trail-reveal" d={route.reveal} pathLength="1" data-draw />
        </mask>
        <g mask={`url(#${maskId})`}>
          <path class="ff-trail-line" d={route.d} />
          <circle class="ff-trail-end" cx={route.end[0].toFixed(1)} cy={route.end[1].toFixed(1)} r="5" />
        </g>
      </g>
    )
  }
</svg>

<style>
  .feather-field {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    color: var(--fg);
    overflow: hidden;
  }
  /* A plume points the way the page reads; geography is never mirrored,
     but this is not geography. */
  :global([dir='rtl']) .feather-follow {
    scale: -1 1;
  }
  path {
    fill: none;
  }
  /* Paths that draw themselves in (pathLength + dash) keep normal
     scaling: under non-scaling-stroke, Chromium measures dashes in screen
     pixels and the draw stops short on any drawing scaled above 1:1. */
  path:not([data-draw]) {
    vector-effect: non-scaling-stroke;
  }
  .ff-barbs {
    stroke: currentColor;
    stroke-width: 0.6;
    stroke-opacity: 0.34;
  }
  .ff-rachis {
    stroke: currentColor;
    stroke-width: 1.1;
    stroke-opacity: 0.6;
  }
  /* In drawing units, so set per variant for about 1.4px on screen. */
  .ff-accent {
    stroke: var(--accent);
    stroke-width: 1.5;
  }
  .feather-cover .ff-accent {
    stroke-width: 1.1;
  }
  .feather-corner .ff-accent {
    stroke-width: 2.4;
  }
  .feather-single .ff-accent {
    stroke-width: 0.8;
  }
  /* Revealed by a solid stroke drawn through a mask, so the dashes and the
     ring arrive in order along the route. */
  .ff-trail-reveal {
    stroke: #fff;
    stroke-width: 24;
  }
  .ff-trail-line {
    stroke: var(--accent);
    stroke-width: 1.4;
    stroke-dasharray: 5 7;
  }
  .ff-trail-end {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.4;
    vector-effect: non-scaling-stroke;
  }
  .ff-trail-reveal[data-draw] {
    transition-duration: 1600ms;
    transition-delay: 500ms;
  }
  .feather-cover .ff-barbs {
    stroke-width: 0.75;
    stroke-opacity: 0.42;
  }
</style>
