---
import { common } from '../../copy/common';
import { categoryLabel, postSlug, type Post } from '../../lib/blog';
import { formatDate, readingMinutes } from '../../lib/format';
import { href, type Locale } from '../../i18n/config';

/** One wrapping link per card, so the whole card is one focus target. */
interface Props {
  post: Post;
  locale: Locale;
  headingLevel?: 'h2' | 'h3';
}
const { post, locale, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const t = common[locale].ui;
const minutes = readingMinutes(post.body ?? '', locale);
---

<article class="h-full">
  <a
    href={`${href(locale, 'blog')}/${postSlug(post)}`}
    class="group flex h-full flex-col gap-3 rounded-lg border border-line bg-white p-6 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:shadow-md"
    data-card
  >
    <p class="text-label uppercase text-fg-2">{categoryLabel[post.data.category][locale]}</p>
    <Heading class="text-h3 font-display group-hover:underline group-hover:underline-offset-4">{post.data.title}</Heading>
    <p class="text-body-sm text-fg-2">{post.data.description}</p>
    <p class="mt-auto pt-2 text-caption text-fg-3">
      <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt, locale)}</time>
      <span aria-hidden="true"> · </span>
      <span class="num">{minutes}</span> {t.minRead}
    </p>
  </a>
</article>
