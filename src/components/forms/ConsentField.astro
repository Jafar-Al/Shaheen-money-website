---
/** Required consent checkbox with a link to the Privacy Policy. 24px box inside a 44px row. */
interface Props {
  before: string;
  linkLabel: string;
  href: string;
}
const { before, linkLabel, href } = Astro.props;
---

<div class="flex flex-col gap-2" data-field="consent">
  <div class="flex items-start gap-3">
    <input
      id="f-consent"
      name="consent"
      type="checkbox"
      value="yes"
      required
      aria-describedby="f-consent-error"
      class="mt-1 size-6 shrink-0 cursor-pointer rounded-sm border border-line-strong accent-blue"
    />
    <label for="f-consent" class="min-h-11 cursor-pointer text-body-sm text-fg">
      {before}
      <a href={href} class="text-blue underline underline-offset-2" target="_blank" rel="noopener">{linkLabel}</a>.
    </label>
  </div>
  <p id="f-consent-error" class="flex items-start gap-2 text-body-sm font-semibold text-error" data-error hidden>
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="mt-0.5 shrink-0">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7.5v5.5M12 16.2v.3"></path>
    </svg>
    <span data-error-text></span>
  </p>
</div>
