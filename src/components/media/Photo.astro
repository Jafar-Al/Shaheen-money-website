---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

/**
 * Every photograph goes through here (audit I.3): AVIF + WebP with a JPEG
 * fallback, a srcset, explicit width/height (no layout shift), lazy by
 * default. Alt text is required; pass alt="" only for purely decorative
 * images together with `decorative`.
 */
type Props = {
  src: ImageMetadata;
  /** Rendered width in CSS pixels at the largest layout — caps the srcset. */
  width: number;
  sizes: string;
  class?: string;
  /** For the LCP image only. */
  priority?: boolean;
} & ({ alt: string; decorative?: false } | { alt: ''; decorative: true });

const { src, width, sizes, class: className, priority = false, alt } = Astro.props;

// 1x, 1.5x and 2x of the layout width, never upscaling past the source.
const widths = [...new Set([width, Math.round(width * 1.5), width * 2].map((w) => Math.min(w, src.width)))];
const height = Math.round((src.height / src.width) * Math.min(width, src.width));
---

<Picture
  src={src}
  alt={alt}
  formats={['avif', 'webp']}
  fallbackFormat="jpg"
  widths={widths}
  sizes={sizes}
  width={Math.min(width, src.width)}
  height={height}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  class={className}
/>
