---
import '../styles/global.css';
import { createHash } from 'node:crypto';
import { Font } from 'astro:assets';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import TrustStrip from '../components/site/TrustStrip.astro';
import DevGaps from '../components/site/DevGaps.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import BrandSprite from '../components/site/BrandSprite.astro';
import DownloadDialog from '../components/site/DownloadDialog.astro';
import { brand, contact, socials, SITE_URL } from '../config/site';
import { common } from '../copy/common';
import { facts } from '../data/facts';
import {
  absoluteUrl,
  alternates as alternatesFor,
  localeMeta,
  localePath,
  locales,
  otherLocale,
  type Locale,
} from '../i18n/config';

interface Props {
  locale: Locale;
  /** Locale-neutral path of this page: '/', '/pricing', '/blog/some-post'. */
  path: string;
  title: string;
  description: string;
  ogType?: 'website' | 'article';
  /** Defaults to the build-time image for this path (src/pages/og/[...slug].png.ts). */
  ogImage?: string;
  noindex?: boolean;
  /** Temperature at the top of the page: Night (home) or Paper (inner pages). */
  temp?: 'night' | 'paper';
  trustStrip?: boolean;
  jsonLd?: Record<string, unknown>[];
  /** When the other language has no version of this page, where the switcher should go. */
  otherLocalePath?: string | undefined;
  article?: { publishedTime: string; modifiedTime?: string | undefined; section: string } | undefined;
  /** Error pages (404): no canonical or hreflang; language links go to each home. */
  errorPage?: boolean;
  /** Load the other locale's faces too: pages that set both scripts (the press kit). */
  bothScripts?: boolean;
}

const {
  locale,
  path,
  title,
  description,
  ogType = 'website',
  ogImage,
  noindex = false,
  temp = 'paper',
  trustStrip = false,
  jsonLd = [],
  otherLocalePath,
  article,
  errorPage = false,
  bothScripts = errorPage,
} = Astro.props;

const meta = localeMeta[locale];
const t = common[locale];
const other = otherLocale(locale);

const selfPath = localePath(locale, path);
const canonical = absoluteUrl(selfPath);
const hasTwin = !otherLocalePath;
const hreflangs = hasTwin ? alternatesFor(path) : [{ hreflang: locale, href: canonical }];
const localeHrefs = Object.fromEntries(
  locales.map((l) => [l, errorPage ? localePath(l, '/') : l === locale ? selfPath : (otherLocalePath ?? localePath(l, path))]),
) as Record<Locale, string>;

const og = absoluteUrl(ogImage ?? `/og/${locale}${path === '/' ? '/index' : path}.png`);

/**
 * Device class before first paint, so the download button's label and icon
 * never shift. THE ONLY PLACE the platform is decided: src/scripts/
 * smart-download.ts reads this answer off the <html> element rather than
 * working it out a second time, so the two can never disagree.
 *
 * iPadOS reports itself as a Mac, and touch points are what give it away.
 * The test is `> 0`, not `> 1`: a Mac reports 0, every iPad reports 5, and
 * getting it wrong in that direction is the expensive one — an iPad shown
 * the desktop treatment is told to scan a QR code with its phone while it
 * is holding the device the app is for.
 *
 * The same script decides how much motion the visitor gets
 * (src/lib/motion/level.ts): reduced for prefers-reduced-motion, lite for
 * save-data, ≤2 GB of memory or ≤4 cores, full otherwise. Deciding it
 * before paint means no scene starts and then stops.
 *
 * Astro does not hash is:inline scripts itself, so the exact string is
 * hashed here and added to this page's CSP.
 */
const platformScript =
  "(function(){var d=document.documentElement,n=navigator,u=n.userAgent,i=/iPhone|iPad|iPod/.test(u)||(/Macintosh/.test(u)&&n.maxTouchPoints>0);d.dataset.platform=i?'ios':/Android/.test(u)?'android':'desktop';var c=n.connection,m=n.deviceMemory,h=n.hardwareConcurrency;d.dataset.motion=matchMedia('(prefers-reduced-motion: reduce)').matches?'reduced':(c&&c.saveData)||(m&&m<=2)||(h&&h<=4)?'lite':'full'})();";
Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(platformScript).digest('base64')}`);

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE_URL}/#organization`,
  name: brand.name,
  alternateName: brand.nameAr,
  url: SITE_URL,
  logo: `${SITE_URL}/icon-512.png`,
  sameAs: socials.map((s) => s.href),
  contactPoint: [
    { '@type': 'ContactPoint', contactType: 'customer support', email: contact.email, availableLanguage: ['en', 'ar'] },
  ],
  ...(facts.company.legalName ? { legalName: facts.company.legalName } : {}),
  ...(facts.company.registeredAddress
    ? { address: facts.company.registeredAddress.en }
    : facts.company.office
      ? { address: facts.company.office.value.address }
      : {}),
  ...(facts.company.office ? { telephone: facts.company.office.value.phone } : {}),
};
---

<!doctype html>
<html lang={locale} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!errorPage && <link rel="canonical" href={canonical} />}
    {!errorPage && hreflangs.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {noindex && <meta name="robots" content="noindex, follow" />}

    <script is:inline set:html={platformScript} />
    <meta name="theme-color" content="#060b1c" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content={meta.ogLocale} />
    {hasTwin && <meta property="og:locale:alternate" content={localeMeta[other].ogLocale} />}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.publishedTime} />
          {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
          <meta property="article:section" content={article.section} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />

    {/* Four files per locale; only the display face is preloaded (it sets
         the headline, the largest paint on every page). */}
    {
      locale === 'ar' ? (
        <>
          <Font cssVariable="--font-naskh" preload />
          <Font cssVariable="--font-plex-arabic" />
          <Font cssVariable="--font-geist-mono" />
        </>
      ) : (
        <>
          <Font cssVariable="--font-instrument-serif" preload />
          <Font cssVariable="--font-instrument-sans" />
          <Font cssVariable="--font-geist-mono" />
        </>
      )
    }
    {/* Pages that set both scripts (the 404, the press kit's specimens)
         carry both sets; unicode-range keeps unused files from loading. */}
    {
      bothScripts &&
        (locale === 'ar' ? (
          <>
            <Font cssVariable="--font-instrument-serif" />
            <Font cssVariable="--font-instrument-sans" />
          </>
        ) : (
          <>
            <Font cssVariable="--font-naskh" />
            <Font cssVariable="--font-plex-arabic" />
          </>
        ))
    }

    <JsonLd data={organization} />
    {jsonLd.map((data) => <JsonLd data={data} />)}
  </head>
  <body class={`t-${temp}`}>
    <BrandSprite />
    <a href="#main" class="skip-link">{t.skipToContent}</a>
    {trustStrip && <TrustStrip locale={locale} />}
    <Header locale={locale} localeHrefs={localeHrefs} temp={temp} />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <Footer locale={locale} localeHrefs={localeHrefs} />
    <DownloadDialog locale={locale} />
    <DevGaps />

    <script>
      import '../scripts/smart-download';
      import '../lib/motion/index';
      import '../scripts/analytics';
    </script>
  </body>
</html>
