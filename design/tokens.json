{
  "$description": "Single source of truth for the Shaheen Money design system (audit section O). Edit this file, then run `npm run tokens` to regenerate src/styles/tokens.css. The build fails if any required colour pair misses its contrast threshold.",

  "color": {
    "navy": "#071138",
    "navy-800": "#0c1a4d",
    "navy-600": "#142a6e",
    "blue": "#1400ff",
    "blue-hover": "#1000cc",
    "cyan": "#00e1ff",

    "white": "#ffffff",
    "subtle": "#f7f8fc",
    "muted": "#f4f5fb",

    "fg": "#071138",
    "fg-2": "#4a5270",
    "fg-3": "#5b6382",
    "fg-inverse": "#ffffff",
    "fg-inverse-2": "rgba(255, 255, 255, 0.72)",

    "line-subtle": "rgba(7, 17, 56, 0.10)",
    "line": "rgba(7, 17, 56, 0.16)",
    "line-strong": "rgba(7, 17, 56, 0.50)",
    "line-inverse": "rgba(255, 255, 255, 0.18)",
    "line-inverse-strong": "rgba(255, 255, 255, 0.45)",

    "success": "#0a7d5a",
    "success-bg": "#e6f5f0",
    "warning": "#8a5a00",
    "warning-bg": "#fdf3e0",
    "error": "#b3261e",
    "error-bg": "#fdeceb",
    "info-bg": "#eceaff",

    "focus": "#1400ff",
    "focus-inverse": "#00e1ff"
  },

  "colorNotes": {
    "blue": "PRIMARY ACTIONS ONLY. Never decoration. Never on navy (1.89:1).",
    "cyan": "Accent for DARK surfaces only. Never text on white (1.59:1).",
    "fg-2": "Darkened from the legacy #5b6382 for headroom on tinted surfaces.",
    "line-strong": "The audit proposed alpha 0.32, which composites to ~2.2:1 on white and fails WCAG 1.4.11. Alpha 0.50 gives ~3.5:1. Use for form-control borders and any boundary a user must perceive.",
    "line": "Card borders. Always paired with shadow-sm so the surface reads without relying on the border alone."
  },

  "contrast": {
    "require": [
      ["fg", "white", 7],
      ["fg-2", "white", 4.5],
      ["fg-2", "subtle", 4.5],
      ["fg-2", "muted", 4.5],
      ["fg-3", "white", 4.5],
      ["fg-3", "subtle", 4.5],
      ["fg-3", "muted", 4.5],
      ["fg-inverse", "navy", 7],
      ["fg-inverse", "navy-800", 4.5],
      ["fg-inverse", "navy-600", 4.5],
      ["fg-inverse-2", "navy", 4.5],
      ["fg-inverse-2", "navy-800", 4.5],
      ["cyan", "navy", 4.5],
      ["cyan", "navy-800", 4.5],
      ["fg-inverse", "blue", 4.5],
      ["fg-inverse", "blue-hover", 4.5],
      ["blue", "white", 4.5],
      ["blue", "subtle", 4.5],
      ["blue", "info-bg", 4.5],
      ["success", "white", 4.5],
      ["success", "success-bg", 4.5],
      ["warning", "white", 4.5],
      ["warning", "warning-bg", 4.5],
      ["error", "white", 4.5],
      ["error", "error-bg", 4.5],
      ["line-strong", "white", 3],
      ["line-inverse-strong", "navy", 3],
      ["focus", "white", 3],
      ["focus", "subtle", 3],
      ["focus-inverse", "navy", 3],
      ["focus-inverse", "navy-800", 3]
    ],
    "forbid": [
      ["cyan", "white"],
      ["cyan", "subtle"],
      ["cyan", "muted"],
      ["blue", "navy"],
      ["blue", "navy-800"]
    ]
  },

  "radius": {
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "full": "9999px"
  },

  "shadow": {
    "sm": "0 1px 2px rgba(7, 17, 56, 0.06), 0 1px 3px rgba(7, 17, 56, 0.08)",
    "md": "0 2px 4px rgba(7, 17, 56, 0.05), 0 8px 16px -6px rgba(7, 17, 56, 0.12)",
    "lg": "0 4px 8px rgba(7, 17, 56, 0.05), 0 24px 48px -16px rgba(7, 17, 56, 0.18)"
  },

  "type": {
    "display-xl": { "size": "clamp(2.75rem, 1.9rem + 3.6vw, 4.5rem)", "lineHeight": 1.06, "tracking": "-0.02em", "weight": 700, "rtlLineHeight": 1.35, "rtlScale": 0.94 },
    "display-lg": { "size": "clamp(2.25rem, 1.7rem + 2.4vw, 3.5rem)", "lineHeight": 1.1, "tracking": "-0.018em", "weight": 700, "rtlLineHeight": 1.35, "rtlScale": 0.96 },
    "h1": { "size": "clamp(2rem, 1.6rem + 1.8vw, 3rem)", "lineHeight": 1.15, "tracking": "-0.015em", "weight": 700, "rtlLineHeight": 1.4, "rtlScale": 1 },
    "h2": { "size": "clamp(1.625rem, 1.4rem + 1.1vw, 2.25rem)", "lineHeight": 1.22, "tracking": "-0.01em", "weight": 650, "rtlLineHeight": 1.45, "rtlScale": 1 },
    "h3": { "size": "clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem)", "lineHeight": 1.32, "tracking": "-0.005em", "weight": 600, "rtlLineHeight": 1.5, "rtlScale": 1.04 },
    "body-lg": { "size": "clamp(1.0625rem, 1rem + 0.25vw, 1.1875rem)", "lineHeight": 1.62, "tracking": "0em", "weight": 400, "rtlLineHeight": 1.8, "rtlScale": 1.0625 },
    "body": { "size": "1rem", "lineHeight": 1.6, "tracking": "0em", "weight": 400, "rtlLineHeight": 1.75, "rtlScale": 1.0625 },
    "body-sm": { "size": "0.9375rem", "lineHeight": 1.55, "tracking": "0em", "weight": 400, "rtlLineHeight": 1.7, "rtlScale": 1.0625 },
    "caption": { "size": "0.8125rem", "lineHeight": 1.45, "tracking": "0.01em", "weight": 500, "rtlLineHeight": 1.65, "rtlScale": 1.08 },
    "label": { "size": "0.75rem", "lineHeight": 1.4, "tracking": "0.06em", "weight": 600, "rtlLineHeight": 1.6, "rtlScale": 1.1 },
    "button": { "size": "0.9375rem", "lineHeight": 1, "tracking": "0.01em", "weight": 600, "rtlLineHeight": 1.3, "rtlScale": 1.0625 },
    "nav": { "size": "0.9375rem", "lineHeight": 1, "tracking": "0em", "weight": 500, "rtlLineHeight": 1.3, "rtlScale": 1.0625 },
    "wordmark": { "size": "1.1875rem", "lineHeight": 1, "tracking": "-0.01em", "weight": 700, "rtlLineHeight": 1, "rtlScale": 1 }
  },

  "typeNotes": {
    "rtlLineHeight": "Arabic descenders (ج ح خ ع غ م ي) are deeper than Latin: headings never below 1.35 in RTL.",
    "rtlScale": "IBM Plex Sans Arabic sets smaller than Inter at the same size; body text is scaled up, display type slightly down to keep line lengths comparable.",
    "tracking": "Letter-spacing is forced to 0 for Arabic regardless of token (connected script)."
  },

  "breakpoint": {
    "sm": "30rem",
    "md": "48rem",
    "lg": "64rem",
    "xl": "80rem",
    "2xl": "96rem"
  },

  "container": {
    "prose": "68ch",
    "sm": "720px",
    "md": "960px",
    "lg": "1200px",
    "xl": "1400px"
  },

  "layout": {
    "gutter": "clamp(16px, 5vw, 48px)",
    "section-y-sm": "clamp(48px, 8vw, 72px)",
    "section-y": "clamp(64px, 10vw, 112px)",
    "section-y-lg": "clamp(80px, 12vw, 144px)",
    "header-h": "72px",
    "target-min": "44px"
  },

  "motion": {
    "duration-fast": "150ms",
    "duration": "200ms",
    "duration-entrance": "360ms",
    "ease-out": "cubic-bezier(0.2, 0.8, 0.2, 1)",
    "ease-in-out": "cubic-bezier(0.4, 0, 0.2, 1)"
  },

  "focus": {
    "width": "2px",
    "offset": "2px"
  }
}
